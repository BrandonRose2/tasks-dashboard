 #00A86B;\n      text-transform: uppercase;\n      margin-bottom: 20px;\n    }\n    .left-title {\n      font-size: 30px;\n      font-weight: 800;\n      color: #FFFFFF;\n      line-height: 1.2;\n      margin-bottom: 16px;\n    }\n    .left-rule {\n      width: 40px;\n      height: 4px;\n      background: #00A86B;\n      margin-bottom: 24px;\n    }\n    .left-desc {\n      font-size: 14px;\n      font-weight: 400;\n      color: rgba(255,255,255,0.65);\n      line-height: 1.7;\n    }\n    .right-col {\n      flex: 1;\n      padding: 52px 64px;\n      display: flex;\n      flex-direction: column;\n      gap: 0;\n    }\n    .section-label {\n      font-size: 10px;\n      font-weight: 700;\n      letter-spacing: 3px;\n      text-transform: uppercase;\n      color: #00A86B;\n      margin-bottom: 28px;\n    }\n    .point-row {\n      display: flex;\n      flex-direction: row;\n      align-items: flex-start;\n      gap: 20px;\n      padding: 18px 0;\n      border-bottom: 1px solid #DEE2E6;\n    }\n    .point-row:first-of-type {\n      border-top: 2px solid #1A2B3C;\n    }\n    .point-accent {\n      width: 4px;\n      min-height: 40px;\n      background: #00A86B;\n      flex-shrink: 0;\n      margin-top: 3px;\n    }\n    .point-text {\n      flex: 1;\n    }\n    .point-heading {\n      font-size: 15px;\n      font-weight: 700;\n      color: #1A2B3C;\n      margin-bottom: 4px;\n    }\n    .point-body {\n      font-size: 13px;\n      font-weight: 400;\n      color: #495057;\n      line-height: 1.5;\n    }\n    .alert-box {\n      margin-top: 20px;\n      background: #1A2B3C;\n      padding: 16px 20px;\n      display: flex;\n      align-items: center;\n      gap: 16px;\n    }\n    .alert-icon {\n      font-size: 22px;\n      color: #00A86B;\n      flex-shrink: 0;\n    }\n    .alert-text {\n      font-size: 13px;\n      font-weight: 600;\n      color: #FFFFFF;\n      line-height: 1.5;\n    }\n    .alert-text span {\n      color: #00A86B;\n    }\n    .bottom-footer {\n      height: 40px;\n      background: #F1F3F5;\n      border-top: 2px solid #DEE2E6;\n      display: flex;\n      align-items: center;\n      padding: 0 64px;\n    }\n    .footer-text {\n      font-size: 10px;\n      font-weight: 500;\n      color: #ADB5BD;\n      letter-spacing: 1px;\n    }\n  \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n  \u003cdiv class=\"slide-container\"\u003e\n    \u003cdiv class=\"top-bar\"\u003e\u003c/div\u003e\n    \u003cdiv class=\"content-area\"\u003e\n      \u003cdiv class=\"left-col\"\u003e\n        \u003cdiv class=\"slide-num\"\u003eFoundation\u003c/div\u003e\n        \u003cdiv class=\"left-title\"\u003eWhy a Structured Process Matters\u003c/div\u003e\n        \u003cdiv class=\"left-rule\"\u003e\u003c/div\u003e\n        \u003cdiv class=\"left-desc\"\u003eEvery new hire at ApartmentCorp follows the same 10-phase process — no steps are skipped, no one falls through the cracks.\u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"right-col\"\u003e\n        \u003cdiv class=\"section-label\"\u003eKey Principles\u003c/div\u003e\n        \u003cdiv class=\"point-row\"\u003e\n          \u003cdiv class=\"point-accent\"\u003e\u003c/div\u003e\n          \u003cdiv class=\"point-text\"\u003e\n            \u003cdiv class=\"point-heading\"\u003eFirst impressions shape long-term retention\u003c/div\u003e\n            \u003cdiv class=\"point-body\"\u003eA structured onboarding experience directly impacts how long a new hire stays and how quickly they become productive.\u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"point-row\"\u003e\n          \u003cdiv class=\"point-accent\"\u003e\u003c/div\u003e\n          \u003cdiv class=\"point-text\"\u003e\n            \u003cdiv class=\"point-heading\"\u003eConsistency eliminates errors and confusion\u003c/div\u003e\n            \u003cdiv class=\"point-body\"\u003eEvery new hire receives the same forms, approvals, training, and credentials — no steps are missed regardless of who manages the process.\u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"point-row\"\u003e\n          \u003cdiv class=\"point-accent\"\u003e\u003c/div\u003e\n          \u003cdiv class=\"point-text\"\u003e\n            \u003cdiv class=\"point-heading\"\u003e10 phases, 8 stakeholders, fully coordinated\u003c/div\u003e\n            \u003cdiv class=\"point-body\"\u003eFrom portal registration to server file archiving, every person has a defined role and every action is tracked with timestamps.\u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"point-row\"\u003e\n          \u003cdiv class=\"point-accent\"\u003e\u003c/div\u003e\n          \u003cdiv class=\"point-text\"\u003e\n            \u003cdiv class=\"point-heading\"\u003eDigital-first — all forms and approvals are paperless\u003c/div\u003e\n            \u003cdiv class=\"point-body\"\u003eThe ApartmentCorp Onboarding Portal handles all form submissions, approvals, credential delivery, and document storage digitally.\u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"alert-box\"\u003e\n          \u003cdiv class=\"alert-icon\"\u003e⏱\u003c/div\u003e\n          \u003cdiv class=\"alert-text\"\u003e\u003cspan\u003eAutomated 3-Hour Alert:\u003c/span\u003e If any new hire has not completed onboarding within 3 hours of their first login, Brandon receives an automatic email alert listing the hire's name, email, and all pending steps.\u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"bottom-footer\"\u003e\n      \u003cdiv class=\"footer-text\"\u003eAPARTMENTCORP \u0026nbsp;|\u0026nbsp; NEW HIRE ONBOARDING PROCESS \u0026nbsp;|\u0026nbsp; INTERNAL USE ONLY\u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n","note":"","width":1280,"height":720},{"id":"overview"