\"\u003e\n    \u003cdiv class=\"top-bar\"\u003e\u003c/div\u003e\n    \u003cdiv class=\"header\"\u003e\n      \u003cdiv class=\"header-left\"\u003e\n        \u003cdiv class=\"phase-label\"\u003ePhase 08 of 10\u003c/div\u003e\n        \u003cdiv class=\"header-title\"\u003eDay 1 Onsite Orientation\u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"header-right\"\u003e\n        \u003cdiv class=\"owner-chip\"\u003e\n          \u003cdiv class=\"chip-label\"\u003eLed By\u003c/div\u003e\n          \u003cdiv class=\"chip-name\"\u003eRegional Manager\u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"owner-chip\"\u003e\n          \u003cdiv class=\"chip-label\"\u003eParticipant\u003c/div\u003e\n          \u003cdiv class=\"chip-name\"\u003eNew Hire\u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"body-area\"\u003e\n      \u003cdiv class=\"left-col\"\u003e\n        \u003cdiv class=\"col-label\"\u003eDay 1 Checklist — Completed Together\u003c/div\u003e\n        \u003cdiv class=\"checklist\"\u003e\n          \u003cdiv class=\"check-row\"\u003e\n            \u003cdiv class=\"check-num\"\u003e1\u003c/div\u003e\n            \u003cdiv class=\"check-content\"\u003e\n              \u003cdiv class=\"check-title\"\u003eProperty Tour\u003c/div\u003e\n              \u003cdiv class=\"check-detail\"\u003eWalk all units, amenities, maintenance areas, laundry facilities, parking, and all emergency exits across the property.\u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"check-row\"\u003e\n            \u003cdiv class=\"check-num\"\u003e2\u003c/div\u003e\n            \u003cdiv class=\"check-content\"\u003e\n              \u003cdiv class=\"check-title\"\u003eTeam Introductions\u003c/div\u003e\n              \u003cdiv class=\"check-detail\"\u003eMeet all current staff, key contacts at the property, and relevant corporate team members. Review org chart and reporting structure.\u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"check-row\"\u003e\n            \u003cdiv class=\"check-num\"\u003e3\u003c/div\u003e\n            \u003cdiv class=\"check-content\"\u003e\n              \u003cdiv class=\"check-title\"\u003eKeys, Access Cards \u0026amp; Building Codes\u003c/div\u003e\n              \u003cdiv class=\"check-detail\"\u003eIssue all physical keys, access cards, gate codes, and alarm codes. New hire signs receipt acknowledgment for all items issued.\u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"check-row\"\u003e\n            \u003cdiv class=\"check-num\"\u003e4\u003c/div\u003e\n            \u003cdiv class=\"check-content\"\u003e\n              \u003cdiv class=\"check-title\"\u003eEmergency Procedures \u0026amp; Safety Protocols\u003c/div\u003e\n              \u003cdiv class=\"check-detail\"\u003eReview fire evacuation routes, emergency contact list, incident reporting procedures, and safety equipment locations.\u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"check-row\"\u003e\n            \u003cdiv class=\"check-num\"\u003e5\u003c/div\u003e\n            \u003cdiv class=\"check-content\"\u003e\n              \u003cdiv class=\"check-title\"\u003eRole Expectations \u0026amp; First Week Schedule\u003c/div\u003e\n              \u003cdiv class=\"check-detail\"\u003eSet clear expectations for the role, daily responsibilities, and provide the first week's schedule. Confirm credential access is working.\u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"right-col\"\u003e\n        \u003cdiv class=\"info-block\"\u003e\n          \u003cdiv class=\"block-title\"\u003eWhat the New Hire Receives\u003c/div\u003e\n          \u003cdiv class=\"info-row\"\u003e\n            \