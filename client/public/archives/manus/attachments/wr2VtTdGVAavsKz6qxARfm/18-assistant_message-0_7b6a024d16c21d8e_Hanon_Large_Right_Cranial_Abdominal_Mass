ition: absolute;\n            left: 0;\n            font-weight: 900;\n        }\n        .meta-text {\n            font-size: 14pt;\n            color: #64748B;\n            margin-top: 12px; /* removed auto spacing and reduced padding */\n            padding-top: 0;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"slide-container\">\n        <div class=\"header-block\">\n            <h1>Hanon: Large Right Cranial Abdominal Mass</h1>\n            <h2>Acute Decline on a Recurrent Background</h2>\n        </div>\n        \n        <div class=\"content-grid\">\n            <div class=\"info-card\">\n                <h3>Patient Profile</h3>\n                <ul>\n                    <li>9-year-3-month-old neutered male Bernedoodle</li>\n                    <li>Weight: 84.6 lb (38.37 kg)</li>\n                    <li>Concurrent left forelimb pain and muscle loss</li>\n                    <li>Extended-neck resting posture observed</li>\n                </ul>\n            </div>\n            \n            <div class=\"info-card\" style=\"border-left-color: #9F1239;\">\n                <h3>Clinical Timeline</h3>\n                <ul>\n                    <li><strong>4–5 weeks ago:</strong> Similar shorter episode of lethargy and reduced function, with rapid improvement</li>\n                    <li><strong>Current (48 hours):</strong> Profound lethargy, minimal intake, prolonged recumbency, reluctance to rise</li>\n                </ul>\n            </div>\n        </div>\n        \n        <div class=\"meta-text\">\n            Integrated case review for specialist consultation | Prepared 16 July 2026\n        </div>\n    </div>\n</body>\n</html>\n","height":720,"id":"slide_1","note":"","path":"/home/ubuntu/hanon_review/presentation/slide_1.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Imaging Confirms a Major Space-Occupying Lesion</title>\n    <style>\n        * { margin: 0