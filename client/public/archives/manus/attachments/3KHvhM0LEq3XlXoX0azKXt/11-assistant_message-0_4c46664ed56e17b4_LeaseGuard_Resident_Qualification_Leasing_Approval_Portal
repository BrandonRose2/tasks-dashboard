{"directory":"/home/ubuntu/property_manager_hiring_review/leslie_leaseguard_pitch","files":[{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>LeaseGuard</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #0A2540; font-family: Arial, Helvetica, sans-serif; display: grid; grid-template-columns: 58% 42%; }\n    .title-zone { border-right: 8px solid #0A2540; display: flex; flex-direction: column; justify-content: center; padding-left: 86px; padding-right: 65px; }\n    .eyebrow { color: #D94838; font-size: 15px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; }\n    h1 { font-family: Georgia, 'Times New Roman', serif; font-size: 78px; line-height: 0.98; letter-spacing: -3px; margin-bottom: 8px; }\n    .subtitle { color: #3A4249; font-size: 25px; line-height: 1.33; max-width: 570px; border-left: 8px solid #D94838; padding-left: 21px; margin-bottom: 8px; }\n    .caption { color: #627D98; font-size: 15px; letter-spacing: 0.5px; margin-top: 8px; }\n    .motif { position: relative; display: flex; align-items: center; justify-content: center; }\n\n    /* Shrunk decorative frame so overall vertical span is reduced */\n    .frame { width: 260px; height: 260px; border: 8px solid #0A2540; position: relative; }\n    .frame::before { content: ''; position: absolute; left: 28px; top: 28px; width: 180px; height: 54px; border: 5px solid #D94838; }\n    .frame::after { content: ''; position: absolute; right: -32px; bottom: 32px; width: 200px; height: 100px; background: #0A2540; }\n\n    /* Keep lines inside the visual center so nothing reaches the bottom edge */\n    .line-a { position: absolute; width: 260px; height: 8px; background: #D94838; top: 176px; left: 30px; }\n    .line-b { position: absolute; width: 8px; height: 150px; background: #D94838; bottom: 48px; left: 48px; }\n\n    /* Raise label upward (larger bottom) so it doesn't approach container bottom */\n    .label { position: absolute; color: #FFFFFF; font-size: 19px; font-weight: 700; right: -4px; bottom: 240px; z-index: 2; width: 225px; line-height: 1.2; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <section class=\"title-zone\">\n      <div class=\"eyebrow\">MVP pitch · resident approval workflow</div>\n      <h1>LeaseGuard</h1>\n      <div class=\"subtitle\">A better way to approve residents—without rushing bad files through.</div>\n      <div class=\"caption\">Resident Qualification &amp; Leasing Approval Portal</div>\n    </section>\n    <section class=\"motif\" aria-label=\"Abstract controlled workflow motif\">\n      <div class=\"frame\" aria-hidden=\"true\"></div>\n      <div class=\"line-a\" aria-hidden=\"true\"></div>\n      <div class=\"line-b\" aria-hidden=\"true\"></div>\n      <div class=\"label\">Complete files.<br>Accountable decisions.</div>\n    </section>\n  </div>\n</body>\n</html>\n","height":720,"id":"cover","note":"","path":"/home/ubuntu/property_manager_hiring_review/leslie_leaseguard_pitch/cover.html","width":1284},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>The Cost of a Bad Approval</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #0A2540; font-family: Arial, Helvetica, sans-serif; padding-top: 48px; }\n    .topline { height: 8px; width: 100%; background: #0A2540; }\n    .kicker { color: #D94838; font-size: 14px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; margin-left: 70px; margin-top: 28px; }\n    h1 { font-family: Georgia, 'Times New Roman', serif; font-size: 48px; line-height: 1.02; letter-spacing: -1.6px; margin-left: 70px; margin-top: 10px; }\n    .content { display: grid; grid-template-columns: 44% 56%; height: 474px; margin-top: 30px; }\n    .quote-zone { border-right: 8px solid #0A2540; padding-left: 70px; padding-right: 58px; padding-top: 38px; }\n    .quote { font-family: Georgia, 'Times New Roman', serif; color: #0A2540; font-size: 31px; line-height: 1.2; }\n    .quote-mark { color: #D94838; font-size: 66px; line-height: 0.5; display: block; margin-bottom: 12px; }\n    .source { color: #627D98; font-size: 14px; line-height: 1.4; margin-top: 28px; }\n    .contrast { color: #D94838; font-size: 18px; font-weight: 700; line-height: 1.35; border-top: 4px solid #D94838; margin-top: 30px; padding-top: 14px; }\n    .chain { padding-left: 52px; padding-right: 70px; padding-top: 36px; }\n    .chain-title { color: #3A4249; font-size: 17px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 19px; }\n    .row { display: grid; grid-template-columns: 72px 1fr; min-height: 73px; border-top: 2px solid #CBD5E1; align-items: center; }\n    .row:last-child { border-bottom: 2px solid #CBD5E1; }\n    .num { color: #D94838; font-family: Georgia, 'Times New Roman', serif; font-size: 42px; font-weight: 700; }\n    .impact { color: #0A2540; font-size: 23px; font-weight: 700; }\n    .detail { color: #627D98; font-size: 14px; margin-top: 4px; }\n    .footer { color: #627D98; font-size: 12px; margin-left: 70px; margin-top: 12px; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"topline\"></div>\n    <div class=\"kicker\">The operating problem</div>\n    <h1>The cost of a bad approval exceeds a short vacancy.</h1>\n    <div class=\"content\">\n      <section class=\"quote-zone\">\n        <span class=\"quote-mark\">“</span>\n        <div class=\"quote\">It’s costing us less to let that unit sit there for a month than it is for us to rent it and try to get them out.</div>\n        <div class=\"source\">— Leslie, supplied discussion recording</div>\n        <div class=\"contrast\">The decision must be supported by a complete file—not by pressure to fill a unit fast.</div>\n      </section>\n      <section class=\"chain\">\n        <div class=\"chain-title\">When verification is rushed, the downside compounds</div>\n        <div class=\"row\"><div class=\"num\">01</div><div><div class=\"impact\">Early delinquency</div><div class=\"detail\">Rent goes unpaid shortly after move-in.</div></div></div>\n        <div class=\"row\"><div class=\"num\">02</div><div><div class=\"impact\">Eviction and staff time</div><div class=\"detail\">The property carries filing, operational, and management burden.</div></div></div>\n        <div class=\"row\"><div class=\"num\">03</div><div><div class=\"impact\">Repeat turn work</div><div class=\"detail\">The unit returns to make-ready instead of stabilizing occupancy.</div></div></div>\n        <div class=\"row\"><div class=\"num\">04</div><div><div class=\"impact\">An unsupported file</div><div class=\"detail\">Leadership cannot see what was verified, missed, or overridden.</div></div></div>\n      </section>\n    </div>\n    <div class=\"footer\">LeaseGuard addresses the approval workflow; it does not create automated approval or denial decisions.</div>\n  </div>\n</body>\n</html>\n","height":720,"id":"cost_of_bad_approval","note":"","path":"/home/ubuntu/property_manager_hiring_review/leslie_leaseguard_pitch/cost_of_bad_approval.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>A Controlled Workflow</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #0A2540; font-family: Arial, Helvetica, sans-serif; padding-top: 48px; }\n    .topline { width: 100%; height: 8px; background: #0A2540; }\n    .kicker { color: #D94838; font-size: 14px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; margin-left: 70px; margin-top: 28px; }\n    h1 { font-family: Georgia, 'Times New Roman', serif; font-size: 48px; line-height: 1.04; letter-spacing: -1.5px; margin-left: 70px; margin-top: 9px; }\n    .subtitle { color: #3A4249; font-size: 20px; line-height: 1.35; margin-left: 70px; margin-top: 13px; max-width: 760px; }\n    .main { display: grid; grid-template-columns: 68% 32%; height: 430px; margin-top: 32px; }\n    .workflow { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 8px solid #0A2540; border-bottom: 2px solid #CBD5E1; margin-left: 70px; }\n    .stage { padding-top: 30px; padding-left: 22px; padding-right: 22px; border-right: 2px solid #CBD5E1; }\n    .stage:last-child { border-right: 0; }\n    .stage-no { color: #D94838; font-family: Georgia, 'Times New Roman', serif; font-size: 52px; font-weight: 700; line-height: 1; }\n    .stage h2 { color: #0A2540; font-family: Georgia, 'Times New Roman', serif; font-size: 26px; line-height: 1.1; margin-top: 20px; }\n    .stage p { color: #486581; font-size: 16px; line-height: 1.45; margin-top: 18px; }\n    .tag { color: #D94838; font-size: 13px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin-top: 28px; }\n    .visual { border-left: 8px solid #0A2540; padding-left: 34px; padding-right: 55px; padding-top: 10px; }\n    .visual-label { color: #627D98; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 14px; }\n    .image-frame { width: 315px; height: 278px; border: 3px solid #0A2540; background: #F8FAFC; display: flex; align-items: center; justify-content: center; }\n    img { width: 301px; height: 264px; object-fit: contain; }\n    .visual-note { color: #627D98; font-size: 13px; line-height: 1.4; margin-top: 13px; width: 315px; }\n    .footer { color: #627D98; font-size: 12px; margin-left: 70px; margin-top: 14px; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"topline\"></div>\n    <div class=\"kicker\">The product model</div>\n    <h1>LeaseGuard turns the approval file into a controlled workflow.</h1>\n    <div class=\"subtitle\">The objective is to make the correct verification steps easier than the shortcut.</div>\n    <div class=\"main\">\n      <section class=\"workflow\">\n        <div class=\"stage\">\n          <div class=\"stage-no\">01</div>\n          <h2>Start with the correct rules.</h2>\n          <p>Property and program context select the approved checklist, evidence needs, and decision route at intake.</p>\n          <div class=\"tag\">Conventional · HUD · LIHTC · Voucher</div>\n        </div>\n        <div class=\"stage\">\n          <div class=\"stage-no\">02</div>\n          <h2>Make evidence visible.</h2>\n          <p>Income, employment, rental history, documents, and verification attempts live in one auditable file.</p>\n          <div class=\"tag\">Evidence · Notes · Activity timeline</div>\n        </div>\n        <div class=\"stage\">\n          <div class=\"stage-no\">03</div>\n          <h2>Route exceptions deliberately.</h2>\n          <p>Files outside policy move to the right reviewer with a complete packet, not an informal email thread.</p>\n          <div class=\"tag\">Authorized review · Rationale · Audit record</div>\n        </div>\n      </section>\n      <aside class=\"visual\">\n        <div class=\"visual-label\">Illustrative management interface</div>\n        <div class=\"image-frame\"><img src=\"https://private-us-east-1.manuscdn.com/sessionFile/3KHvhM0LEq3XlXoX0azKXt/sandbox/slides_resource_i0uzxk669d0s3xsjyj8jg-8c931067-e2b-prod-us2_1787182807356_na1fn_L2hvbWUvdWJ1bnR1L3VwbG9hZC9zZWFyY2hfaW1hZ2VzL2NieGQ4OWV2NXphag.png?x-oss-process=image/resize,w_1560,h_1560/format,webp&Expires=1789430400&__&Key-Pair-Id=K2QY5QTL8JSY6C&Signature=MEUCICeUp4uZfCJDQi~3mQk6L9pxOE3A23ZtWLhOvp8dA5VvAiEAgyKjX9Messi1MvX00nOzovZCAxfzsQREE7TJ2ZaVjwQ_\" alt=\"Illustrative property management dashboard reference\"></div>\n        <div class=\"visual-note\">A manager sees work to do, missing evidence, and exception status before a file reaches final review.</div>\n      </aside>\n    </div>\n    <div class=\"footer\">LeaseGuard is a policy-and-evidence workflow; it does not replace authorized human judgment.</div>\n  </div>\n</body>\n</html>\n","height":720,"id":"controlled_workflow","note":"","path":"/home/ubuntu/property_manager_hiring_review/leslie_leaseguard_pitch/controlled_workflow.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Decision Support, Not Automation</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #0A2540; font-family: Arial, Helvetica, sans-serif; padding-top: 42px; }\n    .top-rule { width: 100%; height: 8px; background: #0A2540; }\n    .kicker { margin-left: 70px; margin-top: 24px; color: #D94838; font-size: 14px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; }\n    h1 { margin-left: 70px; margin-top: 9px; font-family: Georgia, 'Times New Roman', serif; font-size: 48px; line-height: 1.02; letter-spacing: -1.6px; }\n    .subhead { margin-left: 70px; margin-top: 14px; color: #3A4249; font-size: 19px; line-height: 1.35; max-width: 920px; }\n    .comparison { display: grid; grid-template-columns: 1fr 1fr; height: 242px; margin-top: 30px; border-top: 8px solid #0A2540; border-bottom: 2px solid #CBD5E1; }\n    .zone { padding-top: 27px; padding-left: 70px; padding-right: 52px; }\n    .zone.left { border-right: 8px solid #0A2540; background: #FBFCFD; }\n    .zone-label { font-size: 13px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; margin-bottom: 15px; }\n    .zone.left .zone-label { color: #D94838; }\n    .zone.right .zone-label { color: #2F855A; }\n    .zone-title { font-family: Georgia, 'Times New Roman', serif; font-size: 29px; line-height: 1.08; }\n    .zone-copy { color: #486581; font-size: 16px; line-height: 1.42; margin-top: 16px; max-width: 455px; }\n    .strike { display: inline-block; color: #D94838; font-size: 15px; font-weight: 700; margin-top: 18px; border-top: 3px solid #D94838; padding-top: 7px; }\n    .confirm { display: inline-block; color: #276749; font-size: 15px; font-weight: 700; margin-top: 18px; border-top: 3px solid #2F855A; padding-top: 7px; }\n    .sequence-title { margin-left: 70px; margin-top: 23px; color: #3A4249; font-size: 14px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; }\n    .sequence { display: grid; grid-template-columns: repeat(4, 1fr); height: 124px; margin-left: 70px; margin-right: 70px; margin-top: 14px; border-top: 2px solid #CBD5E1; border-bottom: 2px solid #CBD5E1; }\n    .step { padding-top: 16px; padding-left: 17px; padding-right: 16px; border-right: 2px solid #CBD5E1; }\n    .step:last-child { border-right: 0; }\n    .step-no { color: #D94838; font-family: Georgia, 'Times New Roman', serif; font-size: 27px; font-weight: 700; }\n    .step-title { color: #0A2540; font-size: 16px; font-weight: 700; margin-top: 3px; }\n    .step-copy { color: #627D98; font-size: 13px; line-height: 1.28; margin-top: 6px; }\n    .footer { margin-left: 70px; margin-top: 16px; color: #627D98; font-size: 12px; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"top-rule\"></div>\n    <div class=\"kicker\">Governance by design</div>\n    <h1>Decision support, not automation.</h1>\n    <div class=\"subhead\">LeaseGuard makes the file, the policy, and the reviewer’s rationale visible. It does not independently approve or deny a resident.</div>\n\n    <div class=\"comparison\">\n      <section class=\"zone left\">\n        <div class=\"zone-label\">What LeaseGuard is not</div>\n        <div class=\"zone-title\">A black-box approval score.</div>\n        <div class=\"zone-copy\">No hidden model makes a leasing decision. No “green light” can replace required evidence, a policy check, or an authorized reviewer.</div>\n        <div class=\"strike\">No autonomous approvals. No silent overrides.</div>\n      </section>\n      <section class=\"zone right\">\n        <div class=\"zone-label\">What LeaseGuard is</div>\n        <div class=\"zone-title\">A transparent file-readiness workspace.</div>\n        <div class=\"zone-copy\">The team sees the applicable ruleset, what evidence exists, what is missing, and whether an exception requires formal review.</div>\n        <div class=\"confirm\">Named reviewer. Required rationale. Durable audit trail.</div>\n      </section>\n    </div>\n\n    <div class=\"sequence-title\">Every decision follows the same accountable path</div>\n    <div class=\"sequence\">\n      <div class=\"step\"><div class=\"step-no\">01</div><div class=\"step-title\">Ruleset bound</div><div class=\"step-copy\">Property and program requirements are selected at intake.</div></div>\n      <div class=\"step\"><div class=\"step-no\">02</div><div class=\"step-title\">Evidence checked</div><div class=\"step-copy\">The file captures documents and verification activity.</div></div>\n      <div class=\"step\"><div class=\"step-no\">03</div><div class=\"step-title\">Exception routed</div><div class=\"step-copy\">Out-of-policy items move to the right authority.</div></div>\n      <div class=\"step\"><div class=\"step-no\">04</div><div class=\"step-title\">Human decision recorded</div><div class=\"step-copy\">An authorized reviewer documents the outcome and rationale.</div></div>\n    </div>\n    <div class=\"footer\">The portal supports consistently applied written criteria and auditable human review.</div>\n  </div>\n</body>\n</html>\n","height":720,"id":"human_decisions","note":"","path":"/home/ubuntu/property_manager_hiring_review/leslie_leaseguard_pitch/human_decisions.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Manager Command Center</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #0A2540; font-family: Arial, Helvetica, sans-serif; padding-top: 38px; }\n    .topline { width: 100%; height: 8px; background: #0A2540; }\n    .kicker { color: #D94838; font-size: 14px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; margin-left: 64px; margin-top: 22px; }\n    h1 { font-family: Georgia, 'Times New Roman', serif; font-size: 47px; line-height: 1.03; letter-spacing: -1.4px; margin-left: 64px; margin-top: 8px; }\n    .subhead { color: #3A4249; font-size: 19px; line-height: 1.35; margin-left: 64px; margin-top: 10px; }\n    .main { display: grid; grid-template-columns: 70% 30%; height: 476px; margin-top: 25px; }\n    .dashboard { margin-left: 64px; border: 3px solid #0A2540; height: 446px; }\n    .dash-top { height: 56px; border-bottom: 3px solid #0A2540; display: flex; align-items: center; justify-content: space-between; padding-left: 18px; padding-right: 18px; }\n    .dash-brand { font-family: Georgia, 'Times New Roman', serif; font-size: 22px; font-weight: 700; }\n    .dash-meta { color: #627D98; font-size: 13px; font-weight: 700; letter-spacing: 0.5px; }\n    .dash-body { display: grid; grid-template-columns: 150px 1fr; height: 387px; }\n    .sidebar { background: #F3F6F8; border-right: 3px solid #0A2540; padding-top: 16px; }\n    .nav-item { color: #486581; font-size: 14px; font-weight: 700; height: 38px; padding-left: 18px; padding-top: 11px; }\n    .nav-active { background: #0A2540; color: #FFFFFF; }\n    .queue { padding-left: 20px; padding-right: 20px; padding-top: 17px; }\n    .metric-row { display: grid; grid-template-columns: 1fr 1fr 1fr; border: 2px solid #CBD5E1; height: 78px; }\n    .metric { border-right: 2px solid #CBD5E1; padding-left: 14px; padding-top: 10px; }\n    .metric:last-child { border-right: 0; }\n    .metric-label { color: #627D98; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; }\n    .metric-value { color: #0A2540; font-family: Georgia, 'Times New Roman', serif; font-size: 31px; font-weight: 700; margin-top: 2px; }\n    .metric-attention { color: #D94838; }\n    .queue-head { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; margin-bottom: 8px; }\n    .queue-title { color: #0A2540; font-size: 16px; font-weight: 700; }\n    .queue-filter { color: #D94838; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; }\n    .table { border-top: 3px solid #0A2540; border-bottom: 2px solid #CBD5E1; }\n    .table-head, .table-row { display: grid; grid-template-columns: 120px 78px 135px 1fr 38px; align-items: center; }\n    .table-head { height: 30px; background: #F3F6F8; color: #627D98; font-size: 10px; font-weight: 700; letter-spacing: 0.7px; }\n    .table-row { min-height: 50px; border-top: 1px solid #CBD5E1; color: #486581; font-size: 12px; }\n    .name { color: #0A2540; font-weight: 700; }\n    .status { font-size: 10px; font-weight: 700; letter-spacing: 0.3px; }\n    .blocked { color: #B42318; }\n    .review { color: #B7791F; }\n    .progress { color: #1D4ED8; }\n    .ready { color: #277146; }\n    .next { color: #3A4249; }\n    .arrow { color: #D94838; font-size: 19px; font-weight: 700; }\n    .visual { border-left: 8px solid #0A2540; padding-left: 28px; padding-top: 5px; }\n    .visual-label { color: #627D98; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 13px; }\n    .image-frame { width: 315px; height: 240px; border: 3px solid #0A2540; background: #F8FAFC; display: flex; align-items: center; justify-content: center; }\n    img { width: 301px; height: 226px; object-fit: contain; }\n    .callout { width: 315px; border-top: 5px solid #D94838; margin-top: 20px; padding-top: 14px; }\n    .callout-title { color: #0A2540; font-family: Georgia, 'Times New Roman', serif; font-size: 25px; line-height: 1.1; }\n    .callout-copy { color: #486581; font-size: 14px; line-height: 1.38; margin-top: 8px; }\n    .footer { color: #627D98; font-size: 12px; margin-left: 64px; margin-top: 7px; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"topline\"></div>\n    <div class=\"kicker\">Property manager dashboard</div>\n    <h1>One queue tells managers exactly what to do next.</h1>\n    <div class=\"subhead\">The command center converts incomplete files and policy exceptions into visible, assigned next actions.</div>\n    <div class=\"main\">\n      <section class=\"dashboard\" aria-label=\"LeaseGuard manager command center wireframe\">\n        <div class=\"dash-top\"><div class=\"dash-brand\">LeaseGuard</div><div class=\"dash-meta\">WALNUT GROVE &nbsp;·&nbsp; TUESDAY, AUG 19</div></div>\n        <div class=\"dash-body\">\n          <aside class=\"sidebar\">\n            <div class=\"nav-item nav-active\">My Work</div>\n            <div class=\"nav-item\">Applications</div>\n            <div class=\"nav-item\">Exceptions</div>\n            <div class=\"nav-item\">Portfolio</div>\n            <div class=\"nav-item\">Reports</div>\n          </aside>\n          <section class=\"queue\">\n            <div class=\"metric-row\">\n              <div class=\"metric\"><div class=\"metric-label\">ACTIVE FILES</div><div class=\"metric-value\">18</div></div>\n              <div class=\"metric\"><div class=\"metric-label\">NEED ACTION</div><div class=\"metric-value metric-attention\">6</div></div>\n              <div class=\"metric\"><div class=\"metric-label\">EXCEPTIONS</div><div class=\"metric-value\">3</div></div>\n            </div>\n            <div class=\"queue-head\"><div class=\"queue-title\">Priority queue</div><div class=\"queue-filter\">Filters ▾</div></div>\n            <div class=\"table\">\n              <div class=\"table-head\"><div>APPLICANT</div><div>UNIT</div><div>STATUS</div><div>NEXT ACTION</div><div></div></div>\n              <div class=\"table-row\"><div class=\"name\">A. Johnson</div><div>204</div><div class=\"status blocked\">BLOCKED</div><div class=\"next\">Verify prior landlord</div><div class=\"arrow\">→</div></div>\n              <div class=\"table-row\"><div class=\"name\">M. Rivera</div><div>118</div><div class=\"status review\">EXCEPTION</div><div class=\"next\">Submit income variance</div><div class=\"arrow\">→</div></div>\n              <div class=\"table-row\"><div class=\"name\">C. Lee</div><div>307</div><div class=\"status progress\">IN PROGRESS</div><div class=\"next\">Call current employer</div><div class=\"arrow\">→</div></div>\n              <div class=\"table-row\"><div class=\"name\">S. Patel</div><div>110</div><div class=\"status ready\">READY</div><div class=\"next\">Assign decision maker</div><div class=\"arrow\">→</div></div>\n            </div>\n          </section>\n        </div>\n      </section>\n      <aside class=\"visual\">\n        <div class=\"visual-label\">Priority queue reference</div>\n        <div class=\"image-frame\"><img src=\"https://private-us-east-1.manuscdn.com/sessionFile/3KHvhM0LEq3XlXoX0azKXt/sandbox/slides_resource_i0uzxk669d0s3xsjyj8jg-8c931067-e2b-prod-us2_1787182840419_na1fn_L2hvbWUvdWJ1bnR1L3VwbG9hZC9zZWFyY2hfaW1hZ2VzLzZveTdxYTZIR2V3MQ.png?x-oss-process=image/resize,w_1560,h_1560/format,webp&Expires=1789430400&__&Key-Pair-Id=K2QY5QTL8JSY6C&Signature=MEUCIQDX6656QoLaW9nB0CX-12bE4PpXHAPPRHKcYzLHYyOD5QIgWh2qNEE8qty4wfrRt3cy8jNAU9db4Cl7nj3Dq~1BjW8_\" alt=\"Property management dashboard reference for priority queue\"></div>\n        <div class=\"callout\">\n          <div class=\"callout-title\">Status is only useful when it drives an action.</div>\n          <div class=\"callout-copy\">Managers see the blocked item, the accountable owner, and the next step before a file becomes an unsupported approval.</div>\n        </div>\n      </aside>\n    </div>\n    <div class=\"footer\">Manager view is property-scoped and mobile-adapted; portfolio reporting remains aggregate and access-controlled.</div>\n  </div>\n</body>\n</html>\n","height":720,"id":"manager_queue","note":"","path":"/home/ubuntu/property_manager_hiring_review/leslie_leaseguard_pitch/manager_queue.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Every File Makes Evidence Visible</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #0A2540; font-family: Arial, Helvetica, sans-serif; padding-top: 42px; }\n    .top-rule { width: 100%; height: 8px; background: #0A2540; }\n    .kicker { color: #D94838; font-size: 14px; font-weight: 700; letter-spacing: 1.7px; text-transform: uppercase; margin-left: 70px; margin-top: 23px; }\n    h1 { font-family: Georgia, 'Times New Roman', serif; font-size: 47px; line-height: 1.03; letter-spacing: -1.5px; margin-left: 70px; margin-top: 8px; }\n    .deck { color: #486581; font-size: 19px; line-height: 1.36; margin-left: 70px; margin-top: 10px; width: 700px; }\n    .body-grid { display: grid; grid-template-columns: 40% 60%; height: 450px; margin-top: 26px; }\n    .principle { border-right: 8px solid #0A2540; padding-left: 70px; padding-right: 45px; padding-top: 25px; }\n    .statement { color: #0A2540; font-family: Georgia, 'Times New Roman', serif; font-size: 31px; line-height: 1.16; }\n    .red-line { width: 116px; height: 7px; background: #D94838; margin-top: 24px; }\n    .question { border-top: 2px solid #CBD5E1; display: grid; grid-template-columns: 44px 1fr; min-height: 69px; padding-top: 13px; margin-top: 17px; }\n    .question-number { color: #D94838; font-family: Georgia, 'Times New Roman', serif; font-size: 30px; font-weight: 700; }\n    .question-text { color: #3A4249; font-size: 16px; line-height: 1.35; }\n    .question-text strong { color: #0A2540; }\n    .review-zone { padding-left: 40px; padding-right: 70px; padding-top: 5px; }\n    .visual-label { color: #627D98; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 11px; }\n    .screen-frame { width: 560px; height: 255px; border: 4px solid #0A2540; background: #F8FAFC; display: flex; align-items: center; justify-content: center; }\n    .screen-frame img { width: 544px; height: 239px; object-fit: contain; }\n    .checklist { display: grid; grid-template-columns: 1.2fr .9fr 1.05fr .95fr; width: 560px; height: 115px; margin-top: 18px; border-top: 8px solid #0A2540; border-bottom: 2px solid #CBD5E1; }\n    .check { border-right: 2px solid #CBD5E1; padding-left: 14px; padding-right: 12px; padding-top: 12px; }\n    .check:last-child { border-right: 0; }\n    .check-label { color: #627D98; font-size: 11px; font-weight: 700; letter-spacing: .7px; text-transform: uppercase; }\n    .check-value { color: #0A2540; font-size: 15px; font-weight: 700; line-height: 1.22; margin-top: 8px; }\n    .complete { color: #27764B; }\n    .blocked { color: #B42318; }\n    .note { color: #627D98; font-size: 13px; line-height: 1.35; width: 560px; margin-top: 12px; }\n    .footer { color: #627D98; font-size: 12px; margin-left: 70px; margin-top: 5px; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"top-rule\"></div>\n    <div class=\"kicker\">The applicant review workspace</div>\n    <h1>Every file makes evidence visible.</h1>\n    <div class=\"deck\">A manager should never have to guess what was checked, what is missing, or what must happen next.</div>\n    <div class=\"body-grid\">\n      <section class=\"principle\">\n        <div class=\"statement\">File readiness is a transparent checklist—not a black-box score.</div>\n        <div class=\"red-line\"></div>\n        <div class=\"question\">\n          <div class=\"question-number\">01</div>\n          <div class=\"question-text\"><strong>What policy applies?</strong><br>Show the bound property and program ruleset version at the top of every file.</div>\n        </div>\n        <div class=\"question\">\n          <div class=\"question-number\">02</div>\n          <div class=\"question-text\"><strong>What evidence supports it?</strong><br>Keep documents, verification attempts, notes, and outcomes in one traceable view.</div>\n        </div>\n        <div class=\"question\">\n          <div class=\"question-number\">03</div>\n          <div class=\"question-text\"><strong>What must happen next?</strong><br>Block final submission until critical requirements are complete or formally escalated.</div>\n        </div>\n      </section>\n      <section class=\"review-zone\">\n        <div class=\"visual-label\">Illustrative applicant file interface</div>\n        <div class=\"screen-frame\"><img src=\"https://private-us-east-1.manuscdn.com/sessionFile/3KHvhM0LEq3XlXoX0azKXt/sandbox/slides_resource_i0uzxk669d0s3xsjyj8jg-8c931067-e2b-prod-us2_1787182840419_na1fn_L2hvbWUvdWJ1bnR1L3VwbG9hZC9zZWFyY2hfaW1hZ2VzL3FJWWhwcXUwOXd5Tg.png?x-oss-process=image/resize,w_1560,h_1560/format,webp&Expires=1789430400&__&Key-Pair-Id=K2QY5QTL8JSY6C&Signature=MEYCIQCgtkdAsYkwLgDRZc9Vchli-y1gZcjy6yf~Ots~pVxtQgIhAI1e~zDJBb9I6SqSUz6qW24vHcIT0M31cMRBZ93ofKtK\" alt=\"Illustrative tenant dashboard with file status and checklist information\"></div>\n        <div class=\"checklist\">\n          <div class=\"check\"><div class=\"check-label\">Policy</div><div class=\"check-value\">Conventional v1.3</div></div>\n          <div class=\"check\"><div class=\"check-label\">Readiness</div><div class=\"check-value\">5 of 7 checks</div></div>\n          <div class=\"check\"><div class=\"check-label\">Evidence</div><div class=\"check-value complete\">Income + job verified</div></div>\n          <div class=\"check\"><div class=\"check-label\">Next action</div><div class=\"check-value blocked\">Verify prior landlord</div></div>\n        </div>\n        <div class=\"note\">The portal preserves the reason behind each status so the file can be reviewed by the next manager, compliance, or an auditor without reconstructing the story.</div>\n      </section>\n    </div>\n    <div class=\"footer\">Critical requirements remain visible until completed or resolved by an authorized exception decision.</div>\n  </div>\n</body>\n</html>\n","height":720,"id":"applicant_file","note":"","path":"/home/ubuntu/property_manager_hiring_review/leslie_leaseguard_pitch/applicant_file.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>A Consistent Exception Path</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #0A2540; font-family: Arial, Helvetica, sans-serif; padding-top: 45px; }\n    .topline { height: 8px; width: 100%; background: #0A2540; }\n    .kicker { color: #D94838; font-size: 14px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; margin-left: 70px; margin-top: 25px; }\n    h1 { font-family: Georgia, 'Times New Roman', serif; font-size: 49px; line-height: 1.02; letter-spacing: -1.6px; margin-left: 70px; margin-top: 8px; }\n    .subtitle { color: #3A4249; font-size: 19px; line-height: 1.35; margin-left: 70px; margin-top: 12px; max-width: 850px; }\n    .route { display: grid; grid-template-columns: 1fr 1fr 1fr; margin-left: 70px; margin-right: 70px; margin-top: 28px; border-top: 8px solid #0A2540; }\n    .step { min-height: 164px; padding-top: 20px; padding-left: 20px; padding-right: 22px; border-right: 2px solid #CBD5E1; }\n    .step:last-child { border-right: 0; }\n    .number { color: #D94838; font-family: Georgia, 'Times New Roman', serif; font-size: 44px; font-weight: 700; line-height: 1; }\n    .step h2 { font-family: Georgia, 'Times New Roman', serif; font-size: 23px; line-height: 1.08; margin-top: 11px; }\n    .step p { color: #486581; font-size: 15px; line-height: 1.35; margin-top: 9px; }\n    .packet-zone { display: grid; grid-template-columns: 31% 69%; margin-left: 70px; margin-right: 70px; margin-top: 22px; height: 229px; border-top: 2px solid #CBD5E1; border-bottom: 2px solid #CBD5E1; }\n    .packet-intro { background: #0A2540; color: #FFFFFF; padding-top: 27px; padding-left: 24px; padding-right: 24px; }\n    .packet-intro .label { color: #F5C4BD; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; }\n    .packet-intro h3 { font-family: Georgia, 'Times New Roman', serif; font-size: 27px; line-height: 1.1; margin-top: 12px; }\n    .packet-intro p { color: #D9E2EC; font-size: 14px; line-height: 1.4; margin-top: 14px; }\n    .packet { padding-top: 22px; padding-left: 28px; padding-right: 28px; }\n    .packet-title { color: #627D98; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 10px; }\n    .packet-row { display: grid; grid-template-columns: 180px 1fr 130px; min-height: 39px; border-top: 1px solid #CBD5E1; align-items: center; }\n    .packet-row:last-child { border-bottom: 1px solid #CBD5E1; }\n    .field { color: #627D98; font-size: 13px; font-weight: 700; }\n    .value { color: #0A2540; font-size: 15px; }\n    .status { color: #D94838; font-size: 12px; font-weight: 700; letter-spacing: 0.7px; text-transform: uppercase; }\n    .footer { color: #627D98; font-size: 12px; margin-left: 70px; margin-top: 13px; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"topline\"></div>\n    <div class=\"kicker\">Exception governance</div>\n    <h1>A consistent exception path replaces invisible overrides.</h1>\n    <div class=\"subtitle\">A file outside policy should arrive with the evidence, context, and named accountability needed for an authorized human decision.</div>\n\n    <section class=\"route\">\n      <div class=\"step\">\n        <div class=\"number\">01</div>\n        <h2>Submit the exception.</h2>\n        <p>The manager identifies the specific criterion, attaches the evidence, and explains the request in a structured rationale.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"number\">02</div>\n        <h2>Review one complete packet.</h2>\n        <p>Regional or compliance sees the applicable ruleset, file timeline, supporting documents, and unresolved items in one place.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"number\">03</div>\n        <h2>Record an accountable decision.</h2>\n        <p>The reviewer approves or returns the request with rationale; the portal creates the correct next task and audit event.</p>\n      </div>\n    </section>\n\n    <section class=\"packet-zone\">\n      <div class=\"packet-intro\">\n        <div class=\"label\">What the reviewer receives</div>\n        <h3>One file.<br>One policy.<br>One decision.</h3>\n        <p>No reconstruction from disconnected emails, notes, or document folders.</p>\n      </div>\n      <div class=\"packet\">\n        <div class=\"packet-title\">Standardized exception packet · M. Rivera · Walnut Grove</div>\n        <div class=\"packet-row\"><div class=\"field\">Policy criterion</div><div class=\"value\">Documented income-to-rent threshold</div><div class=\"status\">Exception requested</div></div>\n        <div class=\"packet-row\"><div class=\"field\">Ruleset version</div><div class=\"value\">Conventional v1.3</div><div class=\"status\">Policy attached</div></div>\n        <div class=\"packet-row\"><div class=\"field\">Evidence included</div><div class=\"value\">Income documents, employer log, manager rationale</div><div class=\"status\">Ready to review</div></div>\n        <div class=\"packet-row\"><div class=\"field\">Required reviewer action</div><div class=\"value\">Approve or return with written rationale</div><div class=\"status\">Named decision</div></div>\n      </div>\n    </section>\n    <div class=\"footer\">Every exception is bound to the file, the policy version, the reviewer, the rationale, and the time of decision.</div>\n  </div>\n</body>\n</html>\n","height":720,"id":"exception_review","note":"","path":"/home/ubuntu/property_manager_hiring_review/leslie_leaseguard_pitch/exception_review.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Build the Workflow First</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #0A2540; font-family: Arial, Helvetica, sans-serif; padding-top: 42px; }\n    .top-rule { width: 100%; height: 8px; background: #0A2540; }\n    .kicker { margin-left: 70px; margin-top: 23px; color: #D94838; font-size: 14px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; }\n    h1 { margin-left: 70px; margin-top: 8px; font-family: Georgia, 'Times New Roman', serif; font-size: 48px; line-height: 1.02; letter-spacing: -1.6px; }\n    .subhead { margin-left: 70px; margin-top: 12px; color: #3A4249; font-size: 19px; line-height: 1.35; max-width: 930px; }\n    .main { display: grid; grid-template-columns: 62% 38%; height: 428px; margin-top: 29px; }\n    .mvp-zone { margin-left: 70px; border-top: 8px solid #0A2540; border-bottom: 2px solid #CBD5E1; }\n    .mvp-label { color: #627D98; font-size: 12px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; padding-top: 15px; padding-left: 18px; }\n    .workflow { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 13px; }\n    .work-item { min-height: 126px; border-right: 2px solid #CBD5E1; border-top: 2px solid #CBD5E1; padding-top: 15px; padding-left: 18px; padding-right: 16px; }\n    .work-item:nth-child(3n) { border-right: 0; }\n    .number { color: #D94838; font-family: Georgia, 'Times New Roman', serif; font-size: 29px; font-weight: 700; line-height: 1; }\n    .item-title { color: #0A2540; font-size: 16px; font-weight: 700; line-height: 1.2; margin-top: 6px; }\n    .item-copy { color: #627D98; font-size: 13px; line-height: 1.3; margin-top: 6px; }\n    .pilot-zone { border-left: 8px solid #0A2540; background: #0A2540; color: #FFFFFF; padding-top: 25px; padding-left: 32px; padding-right: 48px; }\n    .pilot-label { color: #F5C4BD; font-size: 12px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; }\n    .pilot-title { font-family: Georgia, 'Times New Roman', serif; font-size: 31px; line-height: 1.08; margin-top: 13px; }\n    .pilot-copy { color: #D9E2EC; font-size: 15px; line-height: 1.4; margin-top: 16px; }\n    .property-strip { display: grid; grid-template-columns: 1fr 1fr; border-top: 2px solid #4A6C8D; border-bottom: 2px solid #4A6C8D; margin-top: 22px; }\n    .property { min-height: 76px; padding-top: 12px; padding-left: 13px; padding-right: 12px; border-right: 2px solid #4A6C8D; }\n    .property:last-child { border-right: 0; }\n    .property-type { color: #F5C4BD; font-size: 11px; font-weight: 700; letter-spacing: .8px; text-transform: uppercase; }\n    .property-name { color: #FFFFFF; font-size: 15px; font-weight: 700; margin-top: 5px; }\n    .defer { color: #FFFFFF; font-size: 15px; line-height: 1.35; border-top: 5px solid #D94838; margin-top: 22px; padding-top: 11px; }\n    .defer strong { color: #F5C4BD; }\n    .footer { margin-left: 70px; margin-top: 12px; color: #627D98; font-size: 12px; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"top-rule\"></div>\n    <div class=\"kicker\">MVP scope and pilot strategy</div>\n    <h1>Build the workflow first.</h1>\n    <div class=\"subhead\">The first release earns adoption by making complete files, documented verification, and accountable exceptions faster than the current workaround.</div>\n\n    <div class=\"main\">\n      <section class=\"mvp-zone\">\n        <div class=\"mvp-label\">Build now · the minimum useful workflow</div>\n        <div class=\"workflow\">\n          <div class=\"work-item\"><div class=\"number\">01</div><div class=\"item-title\">Applicant intake</div><div class=\"item-copy\">Property, unit, rent, program, and household basics.</div></div>\n          <div class=\"work-item\"><div class=\"number\">02</div><div class=\"item-title\">Ruleset checklist</div><div class=\"item-copy\">Property/program-specific required evidence and states.</div></div>\n          <div class=\"work-item\"><div class=\"number\">03</div><div class=\"item-title\">Verification log</div><div class=\"item-copy\">Structured employment and rental contact history.</div></div>\n          <div class=\"work-item\"><div class=\"number\">04</div><div class=\"item-title\">Private documents</div><div class=\"item-copy\">Evidence upload, classification, and controlled access.</div></div>\n          <div class=\"work-item\"><div class=\"number\">05</div><div class=\"item-title\">Exception routing</div><div class=\"item-copy\">Standardized packet, authorized review, written rationale.</div></div>\n          <div class=\"work-item\"><div class=\"number\">06</div><div class=\"item-title\">Manager dashboard</div><div class=\"item-copy\">Queue, readiness, bottlenecks, and decision packet export.</div></div>\n        </div>\n      </section>\n\n      <aside class=\"pilot-zone\">\n        <div class=\"pilot-label\">Prove it in two properties</div>\n        <div class=\"pilot-title\">One pilot.<br>Two operating contexts.</div>\n        <div class=\"pilot-copy\">Validate that the same controlled workflow can support a conventional community and a regulated/affordable community without creating more work for site teams.</div>\n        <div class=\"property-strip\">\n          <div class=\"property\"><div class=\"property-type\">Pilot A</div><div class=\"property-name\">Conventional property</div></div>\n          <div class=\"property\"><div class=\"property-type\">Pilot B</div><div class=\"property-name\">Regulated / affordable property</div></div>\n        </div>\n        <div class=\"defer\"><strong>Defer until the workflow is proven:</strong><br>predictive models, broad two-way integrations, and complex vendor automation.</div>\n      </aside>\n    </div>\n    <div class=\"footer\">Success is measured first by adoption, file completeness, exception quality, and turnaround—not by an opaque score.</div>\n  </div>\n</body>\n</html>\n","height":720,"id":"mvp_scope","note":"","path":"/home/ubuntu/property_manager_hiring_review/leslie_leaseguard_pitch/mvp_scope.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Secure, Modular Architecture</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #0A2540; font-family: Arial, Helvetica, sans-serif; padding-top: 38px; }\n    .topline { width: 100%; height: 8px; background: #0A2540; }\n    .kicker { color: #D94838; font-size: 14px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; margin-left: 64px; margin-top: 22px; }\n    h1 { font-family: Georgia, 'Times New Roman', serif; font-size: 47px; line-height: 1.03; letter-spacing: -1.5px; margin-left: 64px; margin-top: 8px; }\n    .subhead { color: #3A4249; font-size: 18px; line-height: 1.35; margin-left: 64px; margin-top: 10px; max-width: 880px; }\n    .main { display: grid; grid-template-columns: 67% 33%; height: 457px; margin-top: 24px; }\n    .diagram-zone { margin-left: 64px; padding-top: 16px; padding-right: 32px; border-top: 8px solid #0A2540; border-bottom: 2px solid #CBD5E1; }\n    .diagram-label { color: #627D98; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 11px; }\n    .diagram-frame { width: 755px; height: 330px; border: 3px solid #0A2540; background: #FFFFFF; display: flex; align-items: center; justify-content: center; }\n    .diagram-frame img { width: 741px; height: 316px; object-fit: contain; }\n    .diagram-note { color: #627D98; font-size: 13px; line-height: 1.35; margin-top: 12px; width: 748px; }\n    .principles { border-left: 8px solid #0A2540; padding-left: 30px; padding-right: 58px; padding-top: 16px; }\n    .principles-heading { color: #627D98; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 13px; }\n    .principle { min-height: 91px; border-top: 2px solid #CBD5E1; padding-top: 11px; }\n    .principle:last-child { border-bottom: 2px solid #CBD5E1; }\n    .principle-no { color: #D94838; font-family: Georgia, 'Times New Roman', serif; font-size: 28px; font-weight: 700; line-height: 1; }\n    .principle-title { color: #0A2540; font-size: 16px; font-weight: 700; line-height: 1.2; margin-top: 3px; }\n    .principle-copy { color: #486581; font-size: 13px; line-height: 1.33; margin-top: 5px; }\n    .red-callout { color: #D94838; font-size: 14px; font-weight: 700; line-height: 1.35; border-top: 5px solid #D94838; padding-top: 12px; margin-top: 17px; }\n    .footer { color: #627D98; font-size: 12px; margin-left: 64px; margin-top: 8px; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"topline\"></div>\n    <div class=\"kicker\">MVP technical foundation</div>\n    <h1>Secure, modular architecture—built for the workflow first.</h1>\n    <div class=\"subhead\">A practical web portal, ruleset-driven workflow service, private evidence storage, and adapter layer let the team pilot now without locking into one property-management or screening vendor.</div>\n\n    <div class=\"main\">\n      <section class=\"diagram-zone\">\n        <div class=\"diagram-label\">LeaseGuard MVP architecture</div>\n        <div class=\"diagram-frame\"><img src=\"https://private-us-east-1.manuscdn.com/sessionFile/3KHvhM0LEq3XlXoX0azKXt/sandbox/slides_resource_i0uzxk669d0s3xsjyj8jg-8c931067-e2b-prod-us2_1787182897664_na1fn_L2hvbWUvdWJ1bnR1L3Byb3BlcnR5X21hbmFnZXJfaGlyaW5nX3Jldmlldy9sZWFzZWd1YXJkX212cF9hcmNoaXRlY3R1cmU.png?x-oss-process=image/resize,w_1560,h_1560/format,webp&Expires=1789430400&__&Key-Pair-Id=K2QY5QTL8JSY6C&Signature=MEUCIQCNGySrXJi3LqsS5aEasjbxIE00loSs9m~af7TiVIZtjQIgQZP3vWwm7lAmDfte4-mxjqdNXQQzhLyJHDN3j15Xjvc_\" alt=\"LeaseGuard system architecture diagram\"></div>\n        <div class=\"diagram-note\">Managers, regional reviewers, and executives work through one web portal. The workflow API enforces role/property scope, ruleset evaluation, evidence capture, exception handling, and auditable human decisions.</div>\n      </section>\n      <aside class=\"principles\">\n        <div class=\"principles-heading\">Why this foundation works</div>\n        <div class=\"principle\">\n          <div class=\"principle-no\">01</div>\n          <div class=\"principle-title\">Workflow control stays on the server.</div>\n          <div class=\"principle-copy\">The browser cannot bypass rules, state transitions, or authorization checks.</div>\n        </div>\n        <div class=\"principle\">\n          <div class=\"principle-no\">02</div>\n          <div class=\"principle-title\">Evidence and audit history are separate, durable records.</div>\n          <div class=\"principle-copy\">Files, policy versions, verification activity, exceptions, and decisions remain reviewable.</div>\n        </div>\n        <div class=\"principle\">\n          <div class=\"principle-no\">03</div>\n          <div class=\"principle-title\">Future integrations are adapters—not dependencies.</div>\n          <div class=\"principle-copy\">Property-management and screening connections can be added after pilot adoption is proven.</div>\n        </div>\n        <div class=\"red-callout\">Build the evidence and approval workflow first. Earn the right to add automation later.</div>\n      </aside>\n    </div>\n    <div class=\"footer\">Recommended stack: React + TypeScript portal · workflow API · MySQL-compatible data store · private object storage · scheduled job outbox · integration adapters.</div>\n  </div>\n</body>\n</html>\n","height":720,"id":"technical_architecture","note":"","path":"/home/ubuntu/property_manager_hiring_review/leslie_leaseguard_pitch/technical_architecture.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Measure What Matters</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #0A2540; font-family: Arial, Helvetica, sans-serif; padding-top: 42px; }\n    .top-rule { width: 100%; height: 8px; background: #0A2540; }\n    .kicker { color: #D94838; font-size: 14px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; margin-left: 70px; margin-top: 24px; }\n    h1 { font-family: Georgia, 'Times New Roman', serif; font-size: 48px; line-height: 1.02; letter-spacing: -1.6px; margin-left: 70px; margin-top: 8px; }\n    .subhead { color: #486581; font-size: 19px; line-height: 1.35; margin-left: 70px; margin-top: 12px; max-width: 820px; }\n    .main { display: grid; grid-template-columns: 57% 43%; height: 448px; margin-top: 27px; }\n    .measures { border-top: 8px solid #0A2540; border-bottom: 2px solid #CBD5E1; margin-left: 70px; padding-top: 4px; }\n    .measure { display: grid; grid-template-columns: 72px 1fr 208px; align-items: center; min-height: 104px; border-bottom: 2px solid #CBD5E1; padding-right: 20px; }\n    .measure:last-child { border-bottom: 0; }\n    .number { color: #D94838; font-family: Georgia, 'Times New Roman', serif; font-size: 39px; font-weight: 700; padding-left: 4px; }\n    .measure-title { color: #0A2540; font-family: Georgia, 'Times New Roman', serif; font-size: 24px; line-height: 1.06; }\n    .measure-copy { color: #486581; font-size: 14px; line-height: 1.35; margin-top: 7px; }\n    .signal { color: #627D98; font-size: 12px; font-weight: 700; letter-spacing: 0.7px; line-height: 1.35; text-transform: uppercase; border-left: 4px solid #D94838; padding-left: 12px; }\n    .visual { border-left: 8px solid #0A2540; padding-left: 35px; padding-top: 0; }\n    .visual-label { color: #627D98; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 14px; }\n    .image-frame { width: 430px; height: 278px; border: 4px solid #0A2540; background: #F8FAFC; display: flex; align-items: center; justify-content: center; }\n    img { width: 414px; height: 262px; object-fit: contain; }\n    .visual-note { width: 430px; border-top: 5px solid #D94838; margin-top: 18px; padding-top: 12px; }\n    .visual-note h2 { color: #0A2540; font-family: Georgia, 'Times New Roman', serif; font-size: 24px; line-height: 1.1; }\n    .visual-note p { color: #486581; font-size: 14px; line-height: 1.37; margin-top: 8px; }\n    .footer { color: #627D98; font-size: 12px; margin-left: 70px; margin-top: 10px; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"top-rule\"></div>\n    <div class=\"kicker\">Management dashboard</div>\n    <h1>Measure what matters—not just units filled.</h1>\n    <div class=\"subhead\">The pilot dashboard makes process quality visible before leadership has to discover the issue through delinquency, audit review, or a returned unit.</div>\n    <div class=\"main\">\n      <section class=\"measures\">\n        <div class=\"measure\">\n          <div class=\"number\">01</div>\n          <div><div class=\"measure-title\">File quality</div><div class=\"measure-copy\">Completion rate, missing evidence, verification completion, and time to a decision-ready file.</div></div>\n          <div class=\"signal\">Can the team assemble a complete file?</div>\n        </div>\n        <div class=\"measure\">\n          <div class=\"number\">02</div>\n          <div><div class=\"measure-title\">Exception health</div><div class=\"measure-copy\">Exception volume, source, approval or return pattern, and time to resolution by property.</div></div>\n          <div class=\"signal\">Where is policy pressure appearing?</div>\n        </div>\n        <div class=\"measure\">\n          <div class=\"number\">03</div>\n          <div><div class=\"measure-title\">Operating outcomes</div><div class=\"measure-copy\">Early-performance indicators and vacancy-versus-risk trends, reviewed at the portfolio level.</div></div>\n          <div class=\"signal\">Is the process protecting the property?</div>\n        </div>\n        <div class=\"measure\">\n          <div class=\"number\">04</div>\n          <div><div class=\"measure-title\">Compliance readiness</div><div class=\"measure-copy\">Audit-ready packet rate, outstanding review items, and ruleset version history.</div></div>\n          <div class=\"signal\">Can the decision be explained later?</div>\n        </div>\n      </section>\n      <aside class=\"visual\">\n        <div class=\"visual-label\">Illustrative portfolio analytics reference</div>\n        <div class=\"image-frame\"><img src=\"https://private-us-east-1.manuscdn.com/sessionFile/3KHvhM0LEq3XlXoX0azKXt/sandbox/slides_resource_i0uzxk669d0s3xsjyj8jg-8c931067-e2b-prod-us2_1787182897664_na1fn_L2hvbWUvdWJ1bnR1L3VwbG9hZC9zZWFyY2hfaW1hZ2VzLzAwQlh5Q1AxWjR4SA.jpg?x-oss-process=image/resize,w_1560,h_1560/format,webp&Expires=1789430400&__&Key-Pair-Id=K2QY5QTL8JSY6C&Signature=MEUCIQDgaXcXpSowfuXnbzCoAnyO-QwJyXadOERXexkBOr9XOAIgbI59P0XKlo-Roo~DD4ztUv5buDV~eDEg4UPvEEbcm-U_\" alt=\"Illustrative rental property management analytics dashboard\"></div>\n        <div class=\"visual-note\">\n          <h2>Leading indicators—not hindsight.</h2>\n          <p>The executive view stays aggregate and access-controlled while showing which properties need workflow coaching or policy review.</p>\n        </div>\n      </aside>\n    </div>\n    <div class=\"footer\">Pilot reporting should establish a baseline first; it should not claim improvement until the team has comparable post-launch data.</div>\n  </div>\n</body>\n</html>\n","height":720,"id":"success_dashboard","note":"","path":"/home/ubuntu/property_manager_hiring_review/leslie_leaseguard_pitch/success_dashboard.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>A Focused Pilot Plan</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #0A2540; font-family: Arial, Helvetica, sans-serif; padding-top: 42px; }\n    .top-rule { height: 8px; width: 100%; background: #0A2540; }\n    .kicker { margin-left: 70px; margin-top: 24px; color: #D94838; font-size: 14px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; }\n    h1 { margin-left: 70px; margin-top: 8px; font-family: Georgia, 'Times New Roman', serif; font-size: 48px; line-height: 1.02; letter-spacing: -1.6px; }\n    .subtitle { margin-left: 70px; margin-top: 12px; color: #3A4249; font-size: 19px; line-height: 1.34; max-width: 920px; }\n    .timeline { display: grid; grid-template-columns: repeat(4, 1fr); height: 236px; margin-left: 70px; margin-right: 70px; margin-top: 32px; border-top: 8px solid #0A2540; border-bottom: 2px solid #CBD5E1; }\n    .phase { padding-top: 22px; padding-left: 20px; padding-right: 20px; border-right: 2px solid #CBD5E1; }\n    .phase:last-child { border-right: 0; }\n    .phase-no { color: #D94838; font-family: Georgia, 'Times New Roman', serif; font-size: 43px; font-weight: 700; line-height: 1; }\n    .phase h2 { margin-top: 12px; font-family: Georgia, 'Times New Roman', serif; font-size: 24px; line-height: 1.08; }\n    .phase p { margin-top: 11px; color: #486581; font-size: 15px; line-height: 1.38; }\n    .phase-tag { margin-top: 15px; color: #627D98; font-size: 11px; font-weight: 700; letter-spacing: .9px; text-transform: uppercase; }\n    .gate { display: grid; grid-template-columns: 31% 69%; height: 148px; margin-left: 70px; margin-right: 70px; margin-top: 27px; }\n    .gate-title { background: #0A2540; color: #FFFFFF; padding-top: 24px; padding-left: 24px; padding-right: 22px; }\n    .gate-title .label { color: #F5C4BD; font-size: 12px; font-weight: 700; letter-spacing: 1.1px; text-transform: uppercase; }\n    .gate-title h3 { margin-top: 11px; font-family: Georgia, 'Times New Roman', serif; font-size: 26px; line-height: 1.08; }\n    .gate-content { border: 3px solid #0A2540; border-left: 0; display: grid; grid-template-columns: repeat(3, 1fr); }\n    .criterion { padding-top: 22px; padding-left: 20px; padding-right: 17px; border-right: 2px solid #CBD5E1; }\n    .criterion:last-child { border-right: 0; }\n    .criterion-number { color: #D94838; font-size: 17px; font-weight: 700; }\n    .criterion-title { color: #0A2540; font-size: 16px; font-weight: 700; line-height: 1.18; margin-top: 5px; }\n    .criterion-copy { color: #627D98; font-size: 13px; line-height: 1.32; margin-top: 6px; }\n    .footer { margin-left: 70px; margin-top: 14px; color: #627D98; font-size: 12px; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"top-rule\"></div>\n    <div class=\"kicker\">Recommended path to launch</div>\n    <h1>Prove the workflow before you scale the technology.</h1>\n    <div class=\"subtitle\">A focused two-property pilot lets the team validate the rules, the manager experience, and the evidence trail before adding complex integrations or analytics.</div>\n\n    <section class=\"timeline\">\n      <div class=\"phase\">\n        <div class=\"phase-no\">01</div>\n        <h2>Run a design workshop.</h2>\n        <p>Bring Leslie, operations, compliance, and strong site managers together to define required evidence, allowable alternatives, and exception authority.</p>\n        <div class=\"phase-tag\">Shared workflow + ruleset</div>\n      </div>\n      <div class=\"phase\">\n        <div class=\"phase-no\">02</div>\n        <h2>Pilot two contrasting properties.</h2>\n        <p>Start with one conventional community and one regulated or affordable community to prove the workflow handles meaningful variation.</p>\n        <div class=\"phase-tag\">Controlled live use</div>\n      </div>\n      <div class=\"phase\">\n        <div class=\"phase-no\">03</div>\n        <h2>Review adoption weekly.</h2>\n        <p>Track incomplete files, exception patterns, turnaround time, and where managers need workflow or policy clarification.</p>\n        <div class=\"phase-tag\">Behavior before analytics</div>\n      </div>\n      <div class=\"phase\">\n        <div class=\"phase-no\">04</div>\n        <h2>Make the scale decision.</h2>\n        <p>Expand only after the pilot shows consistent use, stronger file completeness, and leadership visibility into decision quality.</p>\n        <div class=\"phase-tag\">Evidence-based rollout</div>\n      </div>\n    </section>\n\n    <section class=\"gate\">\n      <div class=\"gate-title\">\n        <div class=\"label\">The scale gate</div>\n        <h3>Do not add complexity until these three conditions are true.</h3>\n      </div>\n      <div class=\"gate-content\">\n        <div class=\"criterion\"><div class=\"criterion-number\">A</div><div class=\"criterion-title\">Managers use the queue.</div><div class=\"criterion-copy\">The daily workflow is faster and clearer than the old workaround.</div></div>\n        <div class=\"criterion\"><div class=\"criterion-number\">B</div><div class=\"criterion-title\">Files are materially more complete.</div><div class=\"criterion-copy\">Evidence, verification activity, and exceptions are consistently documented.</div></div>\n        <div class=\"criterion\"><div class=\"criterion-number\">C</div><div class=\"criterion-title\">Leadership can see the tradeoff.</div><div class=\"criterion-copy\">The dashboard makes file quality and exception behavior visible by property.</div></div>\n      </div>\n    </section>\n    <div class=\"footer\">MVP principle: start with a dependable human workflow; let integrations and analytics earn their place through real usage.</div>\n  </div>\n</body>\n</html>\n","height":720,"id":"pilot_plan","note":"","path":"/home/ubuntu/property_manager_hiring_review/leslie_leaseguard_pitch/pilot_plan.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Complete Files. Accountable Decisions.</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #0A2540; color: #FFFFFF; font-family: Arial, Helvetica, sans-serif; display: grid; grid-template-columns: 63% 37%; }\n    .statement { padding-left: 82px; padding-right: 62px; padding-top: 102px; border-right: 8px solid #FFFFFF; }\n    .kicker { color: #F5C4BD; font-size: 14px; font-weight: 700; letter-spacing: 1.9px; text-transform: uppercase; }\n    h1 { font-family: Georgia, 'Times New Roman', serif; font-size: 61px; line-height: 0.98; letter-spacing: -2.4px; margin-top: 24px; max-width: 690px; }\n    .red-rule { width: 142px; height: 8px; background: #D94838; margin-top: 31px; }\n    .subhead { color: #D9E2EC; font-size: 22px; line-height: 1.36; margin-top: 27px; max-width: 570px; }\n    .caption { color: #AFC8E0; font-size: 15px; line-height: 1.4; margin-top: 30px; max-width: 560px; }\n    .action { padding-top: 108px; padding-left: 42px; padding-right: 54px; }\n    .action-label { color: #F5C4BD; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 18px; }\n    .step { min-height: 106px; border-top: 2px solid #4A6C8D; padding-top: 16px; display: grid; grid-template-columns: 43px 1fr; }\n    .step:last-of-type { border-bottom: 2px solid #4A6C8D; }\n    .step-no { color: #D94838; font-family: Georgia, 'Times New Roman', serif; font-size: 30px; font-weight: 700; }\n    .step-title { color: #FFFFFF; font-size: 17px; font-weight: 700; line-height: 1.23; }\n    .step-copy { color: #D9E2EC; font-size: 14px; line-height: 1.35; margin-top: 5px; }\n    .close-note { color: #FFFFFF; font-family: Georgia, 'Times New Roman', serif; font-size: 25px; line-height: 1.14; margin-top: 28px; border-top: 6px solid #D94838; padding-top: 13px; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <section class=\"statement\">\n      <div class=\"kicker\">The LeaseGuard promise</div>\n      <h1>Complete files.<br>Accountable decisions.</h1>\n      <div class=\"red-rule\"></div>\n      <div class=\"subhead\">Make “fill the unit” compatible with “protect the property.”</div>\n      <div class=\"caption\">LeaseGuard gives leasing teams a faster path to the right verification steps, the right exception review, and a decision record leadership can stand behind.</div>\n    </section>\n    <aside class=\"action\">\n      <div class=\"action-label\">The immediate next move</div>\n      <div class=\"step\"><div class=\"step-no\">01</div><div><div class=\"step-title\">Name the pilot sponsors.</div><div class=\"step-copy\">Bring Leslie, operations, compliance, and site leadership into one design session.</div></div></div>\n      <div class=\"step\"><div class=\"step-no\">02</div><div><div class=\"step-title\">Choose two pilot properties.</div><div class=\"step-copy\">Use one conventional and one regulated/affordable community to validate the workflow.</div></div></div>\n      <div class=\"step\"><div class=\"step-no\">03</div><div><div class=\"step-title\">Approve the workflow before building.</div><div class=\"step-copy\">Define evidence, exception authority, and the management metrics that prove adoption.</div></div></div>\n      <div class=\"close-note\">Start with the decisions that matter most—then scale with evidence.</div>\n    </aside>\n  </div>\n</body>\n</html>\n","height":720,"id":"closing","note":"","path":"/home/ubuntu/property_manager_hiring_review/leslie_leaseguard_pitch/closing.html","width":1280}],"images":{"applicant_file":"https://private-us-east-1.manuscdn.com/slides_screenshots/310519663449376037/3KHvhM0LEq3XlXoX0azKXt/cb6c7293-a020-4c65-b604-a16921493ef4/f70b9577-c1ac-40a9-9ed6-3784cacfcbff_5.png?Expires=1787355703&Signature=qiwXTa0cLbwWZqBjnsZ5EqcdhAZ6eipKjksgUNZv927l2tpeho3JnqLhjFPwtTMj7B8XK-sK7EdB0eTOxKYmQQ6eDR-GjPexOfXL1D0r2cSxD2EPF5fcGul7qbmj2gz6E3aATJnWz9isGi1lH4AiWPFBdgCLBvT2pxfMAp-MENeY4C4w11k3Kqyqa3H9d5VwxvQeMb1ASAl94O3jhyirOl~~Beem6Uxck~W-qCDtn97aMPO6Uw4JkdrL7VJSXm1XiYKdNsKMZSNeYJjS~aVwOZyDa9JXPjn7fbSSIXIXbXWbJKerxcLVIPeMKFBrGnN-g6VYt1zTJuU~aaPzwL6NbA__&Key-Pair-Id=K2HSFNDJXOU9YS","closing":"https://private-us-east-1.manuscdn.com/slides_screenshots/310519663449376037/3KHvhM0LEq3XlXoX0azKXt/cb6c7293-a020-4c65-b604-a16921493ef4/39b580b5-0110-487a-a7ba-d4662397aef2_11.png?Expires=1787355717&Signature=q1LQJpvOAW8b878HMnnC9qKWkPfW6LptkzKQYYD1gtrUCdaLel1s0Ad88KvZncZR3pNLrk8whOGqd6VGyBz09po6Yqb03LqGP-FigUedZtlvJlt082U2C~lTCpEvh01miJqTBvdjuUcRdEHCtUTWLZnyKTHYCs~higw3Yf4AsiQlA~BgnJ3PaFFzB766sXteDjiw5yCj9Yh4K7kX0WcFim6kNjgZhYRGnQfjgG0eT3VHCDnOlYnTzroKIZMqF4b~zz6qYftn1T2zgzgGOYIOoJZHpLiDfNRsSd8CwWG3pVIIasNSyB11h1rOY4oyaBbVEneWIv1zv4BDo6Y5CGoBnQ__&Key-Pair-Id