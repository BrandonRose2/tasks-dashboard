items: center; justify-content: center; background: #242431; }\n    .hero { width: 386px; height: 460px; object-fit: cover; }\n    .index { font-family: \"Courier New\", monospace; font-size: 13px; color: #DFFF00; text-align: right; }\n    .rule { width: 100%; height: 2px; background: #4A4A68; margin-top: 18px; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <section class=\"left\">\n      <div>\n        <div class=\"eyebrow\">Regional manager workflow / pilot proposal</div>\n        <div class=\"rule\"></div>\n        <div style=\"height: 48px;\"></div>\n        <h1>ONE PHOTO.<br>NOT FIVE<br>MINUTES.</h1>\n        <div style=\"height: 34px;\"></div>\n        <p class=\"sub\">An iPhone-first receipt workflow for Webster Visa commercial-card purchases—designed for approximately 30 daily receipts.</p>\n      </div>\n      <div class=\"bottom-row\">\n        <div>\n          <span class=\"tag\">Expensify + Webster Visa</span>\n          <div style=\"height: 18px;\"></div>\n          <p class=\"meta\">Goal: eliminate routine iPhone Safari receipt uploads.<br>Method: capture → match → code → review exceptions.</p>\n        </div>\n        <div class=\"index\">01 / 12</div>\n      </div>\n    </section>\n    <section class=\"right\">\n      <img class=\"logo\" src=\"https://private-us-east-1.manuscdn.com/sessionFile/SMCOeiykXcc8TPY00lOauJ/sandbox/slides_resource_ipt3hg6870blphkjhxqt8-30c3f63e-e2b-prod-us2_1787163457259_na1fn_L2hvbWUvdWJ1bnR1L3VwbG9hZC9zZWFyY2hfaW1hZ2VzL053aEJ2QUtSNldyMg.png?x-oss-process=image/resize,w_1560,h_1560/format,webp&Expires=1789430400&__&Key-Pair-Id=K2QY5QTL8JSY6C&Signature=MEUCIQC8vFYAQZzIZpIlCI9FmEc24WLMyrdCHz81jDNznHtyTwIgFpOOzGmavWWwT7E8V9A5MCZOrJske~at7tT9J-Uo08U_\" alt=\"Webster Bank logo\">\n      <div class=\"image-frame\">\n        <img class=\"hero\" src=\"https://private-us-east-1.manuscdn.com/sessionFile/SMCOeiykXcc8TPY00lOauJ/sandbox/slides_resource_ipt3hg6870blphkjhxqt8-30c3f63e-e2b-prod-us2_1787163457259_na1fn_L2hvbWUvdWJ1bnR1L3VwbG9hZC9zZWFyY2hfaW1hZ2VzL2NsaURaWG9vN1o2eg.jpg?x-oss-process=image/resize,w_1560,h_1560/format,webp&Expires=1789430400&__&Key-Pair-Id=K2QY5QTL8JSY6C&Signature=MEUCIE~wBbU5w9fTI4pgeMyzA~8tdpt8zcnKOPKdOxlC3F0DAiEAg6u4FfBthTE3~HBHr-7rsSD-wUwWhpowDJ94aS-f3vo_\" alt=\"Webster commercial card\">\n      </div>\n      <div class=\"meta\" style=\"text-align:right;\">Operational design • prepared for regional management</div>\n    </section>\n  </div>\n</body>\n</html>\n","height":720,"id":"outcome","note":"","path":"/home/ubuntu/expensify_webster_manager_deck/outcome.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #1A1A24; display: flex; flex-direction: column; }\n    .header { min-height: 118px; border-bottom: 2px solid #1A1A24; padding-top: 32px; padding-right: 58px; padding-left: 58px; display: flex; justify-content: space-between; }\n    .eyebrow, .footer, .note { font-family: \"Courier New\", monospace; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; }\n    .eyebrow { color: #4A4A68; }\n    h1 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 48px; line-height: 0.94; text-transform: uppercase; letter-spacing: -0.8px; margin-top: 12px; }\n    /* Reduced body min-height to bring total under 720px */\n    .body { min-height: 498px; display: grid; grid-template-columns: 43% 57%; }\n    /* Slightly reduced inner paddings to tighten layout without changing fonts */\n    .time-panel { border-right: 2px solid #1A1A24; padding-top: 48px; padding-right: 44px; padding-left: 58px; display: flex; flex-direction: column; justify-content: space-between; }\n    .time-label { font-family: \"Courier New\", monospace; color: #4A4A68; font-size: 14px; text-transform: uppercase; }\n    .equation { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 52px; line-height: 0.98; text-transform: uppercase; letter-spacing: -0.8px; }\n    .lime { color: #7B9300; }\n    .math { font-family: \"Courier New\", monospace; font-size: 17px; line-height: 1.55; color: #4A4A68; }\n    .diagnostics { padding-top: 36px; padding-right: 58px; padding-left: 42px; }\n    .diagnostics-title { font-family: \"Courier New\", monospace; font-size: 13px; color: #4A4A68; text-transform: uppercase; margin-bottom: 18px; }\n    .matrix { border-top: 2px solid #1A1A24; border-left: 2px solid #1A1A24; display: grid; grid-template-columns: 1fr 1fr; }\n    .cell { min-height: 168px; border-right: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; padding-top: 20px; padding-right: 22px; padding-left: 22px; }\n    .cell-id { font-family: \"Courier New\", monospace; color: #7B9300; font-size: 13px; }\n    .cell h2 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 26px; line-height: 0.96; text-transform: uppercase; margin-top: 12px; }\n    .cell p { font-family: \"Courier New\", monospace; font-size: 13px; line-height: 1.35; color: #4A4A68; margin-top: 12px; }\n    .footer { min-height: 70px; border-top: 2px solid #1A1A24; padding-top: 19px; padding-right: 58px; padding-left: 58px; display: flex; justify-content: space-between; color: #4A4A68; }\n    .footer strong { color: #1A1A24; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"header\">\n      <div>\n        <div class=\"eyebrow\">01 / Current-state diagnostic</div>\n        <h1>Today’s workflow loses 2–2.5 hours every day</h1>\n      </div>\n      <div class=\"note\">Observed in demo recordings<br>Team-provided volume estimate</div>\n    </div>\n    <div class=\"body\">\n      <section class=\"time-panel\">\n        <div>\n          <div class=\"time-label\">Daily receipt volume</div>\n          <div style=\"height:16px;\"></div>\n          <div class=\"equation\"><span class=\"lime\">30</span> receipts<br>× <span class=\"lime\">4–5</span> min<br>= <span class=\"lime\">120–150</span><br>min/day</div>\n        </div>\n        <div class=\"math\">The burden is not photo capture alone.<br>It is repeated switching: browser → Photos → portal → transaction lookup → property/GL correction.</div>\n      </section>\n      <section class=\"diagnostics\">\n        <div class=\"diagnostics-title\">Where the time goes</div>\n        <div class=\"matrix\">\n          <div class=\"cell\"><div class=\"cell-id\">01</div><h2>File picker reloads</h2><p>Repeated browse attempts and iPhone Safari friction interrupt basic receipt attachment.</p></div>\n          <div class=\"cell\"><div class=\"cell-id\">02</div><h2>Photo-library search</h2><p>The manager must locate the correct image after leaving the portal session.</p></div>\n          <div class=\"cell\"><div class=\"cell-id\">03</div><h2>Transaction re-find</h2><p>After upload, the manager scrolls to identify the associated commercial-card charge again.</p></div>\n          <div class=\"cell\"><div class=\"cell-id\">04</div><h2>Late coding failure</h2><p>Property lookup and GL validation happen after effort has already been spent.</p></div>\n        </div>\n      </section>\n    </div>\n    <div class=\"footer\"><span><strong>Design conclusion:</strong> remove routine portal attachment from the manager’s job.</span><span>02 / 12</span></div>\n  </div>\n</body>\n</html>\n","height":720,"id":"current_pain","note":"","path":"/home/ubuntu/expensify_webster_manager_deck/current_pain.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #1A1A24; display: flex; flex-direction: column; }\n    .header { min-height: 112px; border-bottom: 2px solid #1A1A24; padding-top: 28px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; }\n    .eyebrow, .footer, .source { font-family: \"Courier New\", monospace; font-size: 12px; letter-spacing: 0.8px; text-transform: uppercase; }\n    .eyebrow { color: #4A4A68; }\n    h1 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 47px; line-height: 0.92; letter-spacing: -0.7px; text-transform: uppercase; margin-top: 10px; }\n    .source { color: #4A4A68; text-align: right; line-height: 1.45; }\n    .content { min-height: 538px; display: grid; grid-template-columns: 76% 24%; }\n    .flow-area { border-right: 2px solid #1A1A24; padding-top: 39px; padding-right: 38px; padding-left: 56px; }\n    .flow-label { font-family: \"Courier New\", monospace; color: #4A4A68; font-size: 13px; text-transform: uppercase; margin-bottom: 22px; }\n    .flow { min-height: 246px; border-top: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; display: grid; grid-template-columns: repeat(5, 1fr); }\n    .stage { border-right: 2px solid #1A1A24; padding-top: 24px; padding-right: 18px; padding-left: 18px; display: flex; flex-direction: column; justify-content: space-between; }\n    .stage:last-child { border-right: 0; }\n    .stage-no { font-family: \"Courier New\", monospace; color: #7B9300; font-size: 14px; }\n    .stage h2 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 26px; line-height: 0.93; text-transform: uppercase; margin-top: 18px; }\n    .stage p { font-family: \"Courier New\", monospace; font-size: 12px; line-height: 1.35; color: #4A4A68; margin-top: 12px; }\n    .accent-stage { background: #DFFF00; }\n    .accent-stage p { color: #1A1A24; }\n    .summary { font-family: \"Courier New\", monospace; font-size: 19px; line-height: 1.5; margin-top: 34px; max-width: 770px; }\n    .summary strong { background: #DFFF00; padding-top: 4px; padding-right: 6px; padding-left: 6px; }\n    .image-area { padding-top: 39px; padding-right: 30px; padding-left: 28px; display: flex; flex-direction: column; justify-content: space-between; }\n    .img-frame { width: 248px; height: 182px; border: 2px solid #1A1A24; }\n    .img-frame img { width: 244px; height: 178px; object-fit: cover; }\n    .image-caption { font-family: \"Courier New\", monospace; font-size: 11px; line-height: 1.4; color: #4A4A68; }\n    .footer { min-height: 70px; border-top: 2px solid #1A1A24; padding-top: 20px; padding-right: 56px; padding-left: 56px; color: #4A4A68; display: flex; justify-content: space-between; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"header\">\n      <div><div class=\"eyebrow\">02 / Target operating model</div><h1>The iPhone-first workflow</h1></div>\n      <div class=\"source\">Routine use begins only<br>after Webster feed activation</div>\n    </div>\n    <div class=\"content\">\n      <section class=\"flow-area\">\n        <div class=\"flow-label\">One receipt follows one controlled path</div>\n        <div class=\"flow\">\n          <div class=\"stage accent-stage\"><div><div class=\"stage-no\">01</div><h2>Capture</h2><p>Manager photographs the receipt in the Expensify iPhone app.</p></div><div class=\"stage-no\">MANAGER</div></div>\n          <div class=\"stage\"><div><div class=\"stage-no\">02</div><h2>Read</h2><p>SmartScan extracts merchant, date, total, and currency.</p></div><div class=\"stage-no\">SMARTSCAN</div></div>\n          <div class=\"stage\"><div><div class=\"stage-no\">03</div><h2>Feed</h2><p>Webster Visa sends the posted commercial-card charge.</p></div><div class=\"stage-no\">VCF</div></div>\n          <div class=\"stage\"><div><div class=\"stage-no\">04</div><h2>Match + Code</h2><p>Expensify associates the receipt and applies tested rules.</p></div><div class=\"stage-no\">RULES</div></div>\n          <div class=\"stage\"><div><div class=\"stage-no\">05</div><h2>Review</h2><p>Finance reviews only policy, coding, or match exceptions.</p></div><div class=\"stage-no\">FINANCE</div></div>\n        </div>\n        <p class=\"summary\"><strong>Manager action:</strong> take the photo once, then continue working. No Safari upload, photo-library search, or transaction re-find.</p>\n      </section>\n      <aside class=\"image-area\">\n        <div class=\"img-frame\"><img src=\"https://private-us-east-1.manuscdn.com/sessionFile/SMCOeiykXcc8TPY00lOauJ/sandbox/slides_resource_ipt3hg6870blphkjhxqt8-30c3f63e-e2b-prod-us2_1787163548543_na1fn_L2hvbWUvdWJ1bnR1L3VwbG9hZC9zZWFyY2hfaW1hZ2VzL2NJSlF1aGZySEd2TA.jpeg?x-oss-process=image/resize,w_1560,h_1560/format,webp&Expires=1789430400&_&Key-Pair-Id=K2QY5QTL8JSY6C&Signature=MEYCIQDgfrvuWYG6l6uP9I6nDomb5Zf9b89qwHLQdtiW5L7m6QIhAMG8ZAVg2K74aZ5FCn57BBFscY5pQzcu6aXqp95nBiZ3\" alt=\"Expensify receipt capture visual\"></div>\n        <p class=\"image-caption\">Expensify receipt capture visual<br>Source: Expensify public materials</p>\n      </aside>\n    </div>\n    <div class=\"footer\"><span>Target state: routine Webster portal receipt uploads = <strong style=\"color:#1A1A24;\">zero</strong></span><span>03 / 12</span></div>\n  </div>\n</body>\n</html>\n","height":720,"id":"future_workflow","note":"","path":"/home/ubuntu/expensify_webster_manager_deck/future_workflow.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #1A1A24; display: flex; flex-direction: column; }\n    .header { min-height: 118px; border-bottom: 2px solid #1A1A24; padding-top: 29px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; }\n    .eyebrow, .source, .footer, .label { font-family: \"Courier New\", monospace; font-size: 12px; letter-spacing: 0.85px; text-transform: uppercase; }\n    .eyebrow, .source { color: #4A4A68; }\n    .source { text-align: right; line-height: 1.42; }\n    h1 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 46px; line-height: 0.92; letter-spacing: -0.7px; text-transform: uppercase; margin-top: 10px; }\n    .main { min-height: 492px; padding-top: 12px; padding-right: 48px; padding-left: 48px; }\n    .gate { min-height: 72px; border: 2px solid #1A1A24; display: grid; grid-template-columns: 248px 1fr; }\n    .gate-label { background: #DFFF00; padding-top: 16px; padding-right: 12px; padding-left: 12px; font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 25px; line-height: 0.95; text-transform: uppercase; }\n    .gate-text { padding-top: 12px; padding-right: 16px; padding-left: 16px; font-family: \"Courier New\", monospace; font-size: 17px; line-height: 1.38; }\n    .two-col { min-height: 266px; margin-top: 12px; border-top: 2px solid #1A1A24; border-left: 2px solid #1A1A24; display: grid; grid-template-columns: 1fr 1fr; }\n    .column { border-right: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; }\n    .column-head { min-height: 56px; background: #1A1A24; color: #FFFFFF; padding-top: 14px; padding-right: 18px; padding-left: 18px; font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 26px; text-transform: uppercase; line-height: 0.94; }\n    .steps { display: grid; grid-template-columns: 1fr 1fr 1fr; min-height: 200px; }\n    .step { border-right: 2px solid #1A1A24; padding-top: 12px; padding-right: 10px; padding-left: 10px; }\n    .step:last-child { border-right: 0; }\n    .num { font-family: \"Courier New\", monospace; font-size: 13px; color: #7B9300; }\n    .step h2 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 22px; line-height: 0.94; text-transform: uppercase; margin-top: 14px; }\n    .step p { font-family: \"Courier New\", monospace; font-size: 12px; line-height: 1.42; color: #4A4A68; margin-top: 12px; }\n    .warning { min-height: 56px; margin-top: 12px; background: #1A1A24; color: #FFFFFF; padding-top: 12px; padding-right: 20px; padding-left: 20px; display: flex; justify-content: space-between; align-items: flex-start; }\n    .warning strong { color: #DFFF00; font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 22px; letter-spacing: 0.1px; text-transform: uppercase; }\n    .warning span { font-family: \"Courier New\", monospace; font-size: 13px; line-height: 1.35; max-width: 700px; text-align: right; }\n    .footer { min-height: 82px; border-top: 2px solid #1A1A24; padding-top: 21px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; color: #4A4A68; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"header\">\n      <div>\n        <div class=\"eyebrow\">03 / Implementation gate</div>\n        <h1>Non-negotiable prerequisite: Webster Visa feed</h1>\n      </div>\n      <div class=\"source\">Source: Expensify Help<br>Commercial Card Feed Connection</div>\n    </div>\n    <main class=\"main\">\n      <div class=\"gate\">\n        <div class=\"gate-label\">The gate condition</div>\n        <div class=\"gate-text\">SmartScan can read a receipt image. <strong>Only the bank-enabled Visa Commercial Format (VCF) feed can deliver the corresponding Webster Visa transaction for automatic matching.</strong></div>\n      </div>\n      <div class=\"two-col\">\n        <section class=\"column\">\n          <div class=\"column-head\">Webster / Visa must provide</div>\n          <div class=\"steps\">\n            <div class=\"step\"><div class=\"num\">01</div><h2>Enable VCF</h2><p>Enable Visa Commercial Format delivery to Expensify through the appropriate bank/Visa process.</p></div>\n            <div class=\"step\"><div class=\"num\">02</div><h2>Send IDs</h2><p>Provide the Processor ID, Financial Institution/Bank ID, and Company ID securely.</p></div>\n            <div class=\"step\"><div class=\"num\">03</div><h2>Confirm timing</h2><p>Confirm feed start date, delivery cadence, and whether transactions are posted-only.</p></div>\n          </div>\n        </section>\n        <section class=\"column\">\n          <div class=\"column-head\">Expensify administrator must do</div>\n          <div class=\"steps\">\n            <div class=\"step\"><div class=\"num\">01</div><h2>Open feed setup</h2><p>Workspace → Company Cards → Add Cards → Commercial Feed → Visa Commercial Cards.</p></div>\n            <div class=\"step\"><div class=\"num\">02</div><h2>Enter IDs</h2><p>Enter the three Webster-provided identifiers, submit, and await connection notice.</p></div>\n            <div class=\"step\"><div class=\"num\">03</div><h2>Assign card</h2><p>Assign the manager’s card to her Workspace account with a controlled start date.</p></div>\n          </div>\n        </section>\n      </div>\n      <div class=\"warning\"><strong>No feed = no match</strong><span>Without VCF activation, Expensify can capture receipts but cannot automatically associate them with the existing Webster commercial-card charge.</span></div>\n    </main>\n    <div class=\"footer\"><span>Request the feed—not a better Safari upload path.</span><span>04 / 12</span></div>\n  </div>\n</body>\n</html>\n","height":720,"id":"vcf_prerequisite","note":"","path":"/home/ubuntu/expensify_webster_manager_deck/vcf_prerequisite.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #1A1A24; display: flex; flex-direction: column; }\n    .header { min-height: 116px; border-bottom: 2px solid #1A1A24; padding-top: 30px; padding-right: 58px; padding-left: 58px; display: flex; justify-content: space-between; }\n    .eyebrow, .footer, .label, .source { font-family: \"Courier New\", monospace; font-size: 12px; letter-spacing: 0.9px; text-transform: uppercase; }\n    .eyebrow, .source { color: #4A4A68; }\n    h1 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 47px; line-height: 0.92; letter-spacing: -0.8px; text-transform: uppercase; margin-top: 10px; }\n    .source { line-height: 1.45; text-align: right; }\n    .content { min-height: 534px; display: grid; grid-template-columns: 42% 58%; }\n    .steps { border-right: 2px solid #1A1A24; padding-top: 36px; padding-right: 35px; padding-left: 58px; }\n    .intro { font-family: \"Courier New\", monospace; font-size: 16px; line-height: 1.45; color: #4A4A68; margin-bottom: 20px; }\n    .step-list { border-top: 2px solid #1A1A24; }\n    .step { min-height: 79px; border-bottom: 2px solid #1A1A24; display: grid; grid-template-columns: 54px 1fr; align-items: center; }\n    .num { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 37px; color: #7B9300; }\n    .step h2 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 25px; line-height: 0.94; letter-spacing: -0.2px; text-transform: uppercase; }\n    .step p { font-family: \"Courier New\", monospace; font-size: 12px; line-height: 1.3; color: #4A4A68; margin-top: 5px; }\n    .quality { margin-top: 21px; border-left: 6px solid #DFFF00; padding-top: 4px; padding-left: 13px; font-family: \"Courier New\", monospace; font-size: 12px; line-height: 1.45; color: #4A4A68; }\n    .quality strong { color: #1A1A24; }\n    .phone-side { padding-top: 31px; padding-right: 58px; padding-left: 36px; display: grid; grid-template-columns: 276px 1fr; column-gap: 28px; }\n    .phone-frame { width: 276px; height: 386px; border: 2px solid #1A1A24; padding-top: 9px; padding-right: 9px; padding-left: 9px; background: #F4F4F6; }\n    .phone-frame img { width: 254px; height: 365px; object-fit: contain; object-position: center top; }\n    .stop-list { border-top: 2px solid #1A1A24; }\n    .stop-head { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 30px; line-height: 0.93; text-transform: uppercase; padding-top: 14px; }\n    .stop { min-height: 79px; border-bottom: 2px solid #1A1A24; padding-top: 14px; }\n    .stop .label { color: #7B9300; }\n    .stop p { font-family: \"Courier New\", monospace; font-size: 13px; line-height: 1.35; color: #4A4A68; margin-top: 6px; }\n    .footer { min-height: 70px; border-top: 2px solid #1A1A24; padding-top: 20px; padding-right: 58px; padding-left: 58px; display: flex; justify-content: space-between; color: #4A4A68; }\n    .footer strong { color: #1A1A24; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <div class=\"header\">\n      <div>\n        <div class=\"eyebrow\">04 / Manager behavior</div>\n        <h1>Capture and continue</h1>\n      </div>\n      <div class=\"source\">The new routine begins after<br>the Webster Visa feed is connected</div>\n    </div>\n    <div class=\"content\">\n      <section class=\"steps\">\n        <p class=\"intro\">The manager should do only the work a phone can do well: capture a clean receipt immediately while the purchase is still fresh.</p>\n        <div class=\"step-list\">\n          <div class=\"step\"><div class=\"num\">01</div><div><h2>Open Expensify</h2><p>Use the company Workspace—not the browser portal.</p></div></div>\n          <div class=\"step\"><div class=\"num\">02</div><div><h2>Tap the in-app camera</h2><p>Photograph the receipt directly in Expensify.</p></div></div>\n          <div class=\"step\"><div class=\"num\">03</div><div><h2>Confirm the workspace</h2><p>Choose Property only when a safe rule did not fill it.</p></div></div>\n          <div class=\"step\"><div class=\"num\">04</div><div><h2>Continue working</h2><p>The posted Visa charge arrives, matches, and is routed for review.</p></div></div>\n        </div>\n        <div class=\"quality\"><strong>Clean-capture standard:</strong> include the full receipt; keep merchant, date, and total visible; avoid glare, shadows, and folds.</div>\n      </section>\n      <section class=\"phone-side\">\n        <div>\n          <div class=\"phone-frame\"><img src=\"https://private-us-east-1.manuscdn.com/sessionFile/SMCOeiykXcc8TPY00lOauJ/sandbox/slides_resource_ipt3hg6870blphkjhxqt8-30c3f63e-e2b-prod-us2_1787163594026_na1fn_L2hvbWUvdWJ1bnR1L3VwbG9hZC9zZWFyY2hfaW1hZ2VzL1o2am1MZDExQVF4dg.png?x-oss-process=image/resize,w_1560,h_1560/format,webp&Expires=1789430400&__&Key-Pair-Id=K2QY5QTL8JSY6C&Signature=MEUCIGx9y5-P0vzSxFa5cwhXqjdhmP5f7OoVosN1IZqE75Z1AiEA6ZLfRrV4otM7ee~ASHR-6pJHGKpeUT2rHxjETyhjVks_\" alt=\"Expensify mobile receipt scanning camera interface\"></div>\n          <div class=\"source\" style=\"margin-top:10px; text-align:left;\">Expensify mobile receipt scanning visual</div>\n        </div>\n        <div class=\"stop-list\">\n          <div class=\"stop-head\">Stop doing this in Safari</div>\n          <div class=\"stop\"><div class=\"label\">Do not</div><p>Search the photo library after leaving the transaction screen.</p></div>\n          <div class=\"stop\"><div class=\"label\">Do not</div><p>Browse, reload, and retry the Webster portal file picker.</p></div>\n          <div class=\"stop\"><div class=\"label\">Do not</div><p>Scroll back through transactions to attach the receipt a second time.</p></div>\n        </div>\n      </section>\n    </div>\n    <div class=\"footer\"><span><strong>Manager rule:</strong> one receipt image in Expensify; exceptions only receive follow-up.</span><span>05 / 12</span></div>\n  </div>\n</body>\n</html>\n","height":720,"id":"manager_routine","note":"","path":"/home/ubuntu/expensify_webster_manager_deck/manager_routine.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #1A1A24; display: flex; flex-direction: column; }\n    .header { min-height: 118px; border-bottom: 2px solid #1A1A24; padding-top: 29px; padding-right: 58px; padding-left: 58px; display: flex; justify-content: space-between; }\n    .eyebrow, .footer, .source, .lane-label, .row-id { font-family: \"Courier New\", monospace; font-size: 12px; letter-spacing: 0.8px; text-transform: uppercase; }\n    .eyebrow, .source { color: #4A4A68; }\n    h1 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 46px; line-height: 0.92; letter-spacing: -0.6px; text-transform: uppercase; margin-top: 11px; }\n    .source { text-align: right; line-height: 1.45; }\n    .body { min-height: 532px; display: grid; grid-template-columns: 74% 26%; }\n    .stack { border-right: 2px solid #1A1A24; padding-top: 32px; padding-right: 42px; padding-left: 58px; }\n    .lane-label { color: #4A4A68; margin-bottom: 16px; }\n    .rows { border-top: 2px solid #1A1A24; }\n    /* Reduced each row height by 6px (76 -> 70) to reclaim vertical space without changing fonts */\n    .row { min-height: 70px; display: grid; grid-template-columns: 70px 190px 1fr; border-bottom: 2px solid #1A1A24; align-items: center; }\n    .row-id { color: #7B9300; padding-left: 16px; }\n    .row-name { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 25px; line-height: 0.9; text-transform: uppercase; border-left: 2px solid #1A1A24; min-height: 68px; display: flex; align-items: center; padding-left: 18px; }\n    .row-copy { font-family: \"Courier New\", monospace; font-size: 13px; line-height: 1.35; color: #4A4A68; border-left: 2px solid #1A1A24; min-height: 68px; display: flex; align-items: center; padding-left: 18px; padding-right: 16px; }\n    .exception { background: #1A1A24; color: #FFFFFF; padding-top: 32px; padding-right: 30px; padding-left: 30px; display: flex; flex-direction: column; justify-content: space-between; }\n    .exception .lane-label { color: #DFFF00; }\n    .exception h2 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 36px; line-height: 0.9; text-transform: uppercase; margin-top: 18px; }\n    .exception p { font-family: \"Courier New\", monospace; font-size: 14px; line-height: 1.45; color: #D8D8E2; margin-top: 19px; }\n    .rule { height: 2px; background: #DFFF00; width: 100%; margin-top: 24px; }\n    .exceptions-list { border-top: 2px solid #4A4A68; }\n    /* Slightly reduced exception items (50 -> 44) to balance column heights */\n    .exception-item { min-height: 44px; border-bottom: 2px solid #4A4A68; font-family: \"Courier New\", monospace; font-size: 12px; line-height: 1.3; display: flex; align-items: center; color: #FFFFFF; }\n    .footer { min-height: 70px; border-top: 2px solid #1A1A24; padding-top: 20px; padding-right: 58px; padding-left: 58px; display: flex; justify-content: space-between; color: #4A4A68; }\n    .footer strong { color: #1A1A24; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <header class=\"header\">\n      <div>\n        <div class=\"eyebrow\">05 / Automation architecture</div>\n        <h1>SmartScan reads; rules make it accounting-ready</h1>\n      </div>\n      <div class=\"source\">Automation supports control.<br>It does not replace review.</div>\n    </header>\n    <main class=\"body\">\n      <section class=\"stack\">\n        <div class=\"lane-label\">System-managed layers / applied in sequence</div>\n        <div class=\"rows\">\n          <div class=\"row\"><div class=\"row-id\">01</div><div class=\"row-name\">SmartScan</div><div class=\"row-copy\">Reads merchant, date, total, and currency from a readable receipt image.</div></div>\n          <div class=\"row\"><div class=\"row-id\">02</div><div class=\"row-name\">Visa Feed</div><div class=\"row-copy\">Delivers the posted Webster commercial-card transaction after bank-side VCF activation.</div></div>\n          <div class=\"row\"><div class=\"row-id\">03</div><div class=\"row-name\">Category Defaults</div><div class=\"row-copy\">Applies a broad expense type from merchant/category patterns; not a property allocation.</div></div>\n          <div class=\"row\"><div class=\"row-id\">04</div><div class=\"row-name\">Merchant Rules</div><div class=\"row-copy\">Auto-fills only finance-approved category, description, or safe tag patterns for known vendors.</div></div>\n          <div class=\"row\"><div class=\"row-id\">05</div><div class=\"row-name\">Dependent Tags</div><div class=\"row-copy\">Shows only valid GL choices once the correct Property has been selected or safely inferred.</div></div>\n        </div>\n      </section>\n      <aside class=\"exception\">\n        <div>\n          <div class=\"lane-label\">Human exception lane</div>\n          <div class=\"rule\"></div>\n          <h2>Finance reviews<br>ambiguity.</h2>\n          <p>People intervene when a receipt is unclear, a transaction has not posted, a merchant serves multiple properties, or a coding rule produces doubt.</p>\n        </div>\n        <div class=\"exceptions-list\">\n          <div class=\"exception-item\">Unclear / unreadable receipt</div>\n          <div class=\"exception-item\">Multiple-property vendor</div>\n          <div class=\"exception-item\">New or unverified merchant</div>\n          <div class=\"exception-item\">Possible incorrect match or code</div>\n        </div>\n      </aside>\n    </main>\n    <footer class=\"footer\"><span><strong>Control rule:</strong> one incorrect automatic Property code is worse than one visible exception.</span><span>06 / 12</span></footer>\n  </div>\n</body>\n</html>\n","height":743,"id":"automation_layers","note":"","path":"/home/ubuntu/expensify_webster_manager_deck/automation_layers.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #1A1A24; display: flex; flex-direction: column; }\n    .header { min-height: 108px; border-bottom: 2px solid #1A1A24; padding-top: 28px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; }\n    .eyebrow, .meta, .footer, .small-label { font-family: \"Courier New\", monospace; font-size: 12px; letter-spacing: 0.8px; text-transform: uppercase; }\n    .eyebrow, .meta { color: #4A4A68; }\n    h1 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 44px; line-height: 0.92; letter-spacing: -0.6px; text-transform: uppercase; margin-top: 10px; }\n    .content { min-height: 542px; display: grid; grid-template-columns: 68% 32%; }\n    .map-panel { border-right: 2px solid #1A1A24; padding-top: 34px; padding-right: 38px; padding-left: 56px; }\n    .side-panel { padding-top: 34px; padding-right: 56px; padding-left: 32px; }\n    .section-title { font-family: \"Courier New\", monospace; font-size: 13px; color: #4A4A68; text-transform: uppercase; margin-bottom: 8px; }\n    /* keep map height reasonable */\n    .map { border-top: 2px solid #1A1A24; border-left: 2px solid #1A1A24; display: grid; grid-template-columns: 40% 13% 47%; min-height: 273px; }\n    .map-head { min-height: 50px; border-right: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; padding-top: 16px; padding-right: 14px; padding-left: 14px; font-family: \"Courier New\", monospace; font-size: 12px; color: #4A4A68; text-transform: uppercase; }\n    .property { border-right: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; padding-top: 24px; padding-right: 18px; padding-left: 18px; }\n    .property strong { display: block; font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 28px; line-height: 0.96; text-transform: uppercase; }\n    .property span { display: block; margin-top: 10px; font-family: \"Courier New\", monospace; font-size: 12px; color: #4A4A68; line-height: 1.35; }\n    .arrow { border-right: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; display: flex; align-items: center; justify-content: center; font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 36px; color: #7B9300; }\n    .gl { border-right: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; padding-top: 18px; padding-right: 18px; padding-left: 18px; }\n    .gl-line { display: flex; justify-content: space-between; border-bottom: 1px solid #4A4A68; padding-top: 7px; padding-right: 0; padding-left: 0; font-family: \"Courier New\", monospace; font-size: 13px; line-height: 1.25; }\n    .gl-line:last-child { border-bottom: 0; }\n    .code { color: #4A4A68; }\n    .map-note { font-family: \"Courier New\", monospace; font-size: 15px; line-height: 1.45; margin-top: 19px; max-width: 740px; }\n    .rule-stack { border-top: 2px solid #1A1A24; border-left: 2px solid #1A1A24; }\n    /* Reduced internal padding and min-height for rules to remove overflow */\n    .rule { min-height: 85px; border-right: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; padding-top: 8px; padding-right: 12px; padding-left: 12px; }\n    .rule-id { font-family: \"Courier New\", monospace; font-size: 12px; color: #7B9300; }\n    .rule h2 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 23px; line-height: 0.95; text-transform: uppercase; margin-top: 8px; }\n    .rule p { font-family: \"Courier New\", monospace; font-size: 12px; line-height: 1.35; color: #4A4A68; margin-top: 8px; }\n    .risk { background: #DFFF00; color: #1A1A24; padding-top: 12px; padding-right: 16px; padding-left: 16px; font-family: \"Courier New\", monospace; font-size: 13px; line-height: 1.35; min-height: 78px; }\n    .footer { min-height: 70px; border-top: 2px solid #1A1A24; padding-top: 19px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; color: #4A4A68; }\n    .footer strong { color: #1A1A24; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <header class=\"header\">\n      <div>\n        <div class=\"eyebrow\">06 / Coding controls</div>\n        <h1>Reduce taps without hiding errors</h1>\n      </div>\n      <div class=\"meta\">Finance-approved configuration pattern<br>Illustrative property / GL mapping</div>\n    </header>\n    <main class=\"content\">\n      <section class=\"map-panel\">\n        <div class=\"section-title\">Dependent tags: select Property → see only permitted GL choices</div>\n        <div class=\"map\">\n          <div class=\"map-head\">Tag Level 1 / Property</div><div class=\"map-head\">Logic</div><div class=\"map-head\">Tag Level 2 / permitted GL account</div>\n          <div class=\"property\"><strong>497 — Grove Park Housing</strong><span>Property is visible to the manager.</span></div>\n          <div class=\"arrow\">→</div>\n          <div class=\"gl\"><div class=\"gl-line\"><span>Repairs &amp; Maintenance</span><span class=\"code\">6XXX</span></div><div class=\"gl-line\"><span>Lodging</span><span class=\"code\">6XXX</span></div></div>\n          <div class=\"property\"><strong>473 — Silver Springs Housing</strong><span>Property is visible to the manager.</span></div>\n          <div class=\"arrow\">→</div>\n          <div class=\"gl\"><div class=\"gl-line\"><span>Repairs &amp; Maintenance</span><span class=\"code\">6XXX</span></div><div class=\"gl-line\"><span>Lodging</span><span class=\"code\">6XXX</span></div></div>\n        </div>\n        <p class=\"map-note\"><strong>Why this matters:</strong> the manager does not search one long all-company GL list. Finance defines the permitted combinations once; Expensify presents only valid next choices.</p>\n      </section>\n      <aside class=\"side-panel\">\n        <div class=\"section-title\">Merchant-rule guardrails</div>\n        <div class=\"rule-stack\">\n          <div class=\"rule\"><div class=\"rule-id\">SAFE TO AUTOMATE</div><h2>Property-exclusive vendor</h2><p>Exact merchant match → Category + Property Tag, after finance validates the relationship.</p></div>\n          <div class=\"rule\"><div class=\"rule-id\">CATEGORY ONLY</div><h2>Shared hotel or retailer</h2><p>Auto-fill the expense type, but leave Property for the manager or finance.</p></div>\n          <div class=\"rule\"><div class=\"rule-id\">NO RULE YET</div><h2>New / one-off merchant</h2><p>Keep it visible as an exception until a repeatable, auditable pattern exists.</p></div>\n        </div>\n        <div class=\"risk\"><strong>Control standard:</strong> one incorrect automatic Property code is worse than one visible exception.</div>\n      </aside>\n    </main>\n    <footer class=\"footer\"><span><strong>Start small:</strong> 5–10 exact merchant rules; review every new Property rule.</span><span>07 / 12</span></footer>\n  </div>\n</body>\n</html>\n","height":747,"id":"coding_controls","note":"","path":"/home/ubuntu/expensify_webster_manager_deck/coding_controls.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #1A1A24; display: flex; flex-direction: column; }\n    .header { min-height: 112px; border-bottom: 2px solid #1A1A24; padding-top: 28px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; }\n    .eyebrow, .meta, .footer, .label, .source { font-family: \"Courier New\", monospace; font-size: 12px; letter-spacing: 0.85px; text-transform: uppercase; }\n    .eyebrow, .meta, .source { color: #4A4A68; }\n    h1 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 45px; line-height: 0.92; letter-spacing: -0.7px; text-transform: uppercase; margin-top: 10px; }\n    .source { line-height: 1.42; text-align: right; }\n    /* Reduced body and inner element heights/paddings to remove overflow */\n    .body { min-height: 500px; display: grid; grid-template-columns: 64% 36%; }\n    .timeline-panel { border-right: 2px solid #1A1A24; padding-top: 20px; padding-right: 20px; padding-left: 34px; }\n    .criteria-panel { padding-top: 20px; padding-right: 56px; padding-left: 16px; }\n    .section-label { font-family: \"Courier New\", monospace; font-size: 13px; color: #4A4A68; text-transform: uppercase; margin-bottom: 14px; }\n    .pilot-scope { min-height: 46px; border: 2px solid #1A1A24; display: grid; grid-template-columns: 130px 1fr; }\n    .scope-label { background: #DFFF00; padding-top: 14px; padding-right: 12px; padding-left: 12px; font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 21px; line-height: 0.95; text-transform: uppercase; }\n    .scope-copy { padding-top: 9px; padding-right: 12px; padding-left: 12px; font-family: \"Courier New\", monospace; font-size: 13px; line-height: 1.35; }\n    .timeline { min-height: 236px; margin-top: 20px; border-top: 2px solid #1A1A24; border-left: 2px solid #1A1A24; display: grid; grid-template-columns: repeat(5, 1fr); }\n    .day { border-right: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; padding-top: 14px; padding-right: 10px; padding-left: 10px; display: flex; flex-direction: column; justify-content: space-between; }\n    .day.active { background: #DFFF00; }\n    .day-id { font-family: \"Courier New\", monospace; font-size: 12px; color: #4A4A68; text-transform: uppercase; }\n    .day h2 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 25px; line-height: 0.92; text-transform: uppercase; margin-top: 12px; }\n    .day p { font-family: \"Courier New\", monospace; font-size: 12px; line-height: 1.35; color: #4A4A68; margin-top: 8px; }\n    .owner { font-family: \"Courier New\", monospace; font-size: 11px; letter-spacing: 0.6px; color: #1A1A24; text-transform: uppercase; }\n    .timeline-note { margin-top: 14px; font-family: \"Courier New\", monospace; font-size: 14px; line-height: 1.43; color: #4A4A68; }\n    .criteria { border-top: 2px solid #1A1A24; border-left: 2px solid #1A1A24; display: grid; grid-template-columns: 1fr 1fr; }\n    .criterion { min-height: 100px; border-right: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; padding-top: 10px; padding-right: 12px; padding-left: 12px; }\n    .criterion-id { font-family: \"Courier New\", monospace; font-size: 11px; color: #7B9300; }\n    .criterion h3 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 20px; line-height: 0.93; text-transform: uppercase; margin-top: 6px; }\n    .criterion p { font-family: \"Courier New\", monospace; font-size: 11px; line-height: 1.31; color: #4A4A68; margin-top: 6px; }\n    .decision { min-height: 60px; margin-top: 12px; background: #1A1A24; color: #FFFFFF; padding-top: 10px; padding-right: 16px; padding-left: 16px; display: flex; justify-content: space-between; align-items: flex-start; }\n    .decision strong { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 23px; line-height: 0.92; text-transform: uppercase; color: #DFFF00; }\n    .decision span { font-family: \"Courier New\", monospace; font-size: 11px; line-height: 1.38; color: #D8D8E2; max-width: 168px; text-align: right; }\n    .footer { min-height: 70px; border-top: 2px solid #1A1A24; padding-top: 20px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; color: #4A4A68; }\n    .footer strong { color: #1A1A24; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <header class=\"header\">\n      <div>\n        <div class=\"eyebrow\">07 / Controlled pilot</div>\n        <h1>10 receipts. One manager. One week.</h1>\n      </div>\n      <div class=\"source\">Internal acceptance criteria<br>Not vendor service-level commitments</div>\n    </header>\n    <main class=\"body\">\n      <section class=\"timeline-panel\">\n        <div class=\"section-label\">Pilot sequence</div>\n        <div class=\"pilot-scope\">\n          <div class=\"scope-label\">Scope</div>\n          <div class=\"scope-copy\"><strong>One assigned Webster Visa card</strong> • One Expensify Workspace • Ten ordinary receipts • No production accounting export until finance sign-off</div>\n        </div>\n        <div class=\"timeline\">\n          <div class=\"day\"><div><div class=\"day-id\">Day 0</div><h2>Configure</h2><p>Confirm VCF connection, card assignment, receipt rules, tags, and pilot start date.</p></div><div class=\"owner\">Card Admin + Finance</div></div>\n          <div class=\"day active\"><div><div class=\"day-id\">Days 1–3</div><h2>Capture</h2><p>Manager photographs each receipt in Expensify at point of purchase.</p></div><div class=\"owner\">Manager</div></div>\n          <div class=\"day\"><div><div class=\"day-id\">Days 1–4</div><h2>Match</h2><p>Posted Webster transactions arrive through the feed and associate with receipt images.</p></div><div class=\"owner\">Feed + Rules</div></div>\n          <div class=\"day\"><div><div class=\"day-id\">Day 4</div><h2>Review</h2><p>Finance checks match, Property, GL, category, and exception visibility.</p></div><div class=\"owner\">Finance</div></div>\n          <div class=\"day\"><div><div class=\"day-id\">Day 5</div><h2>Decide</h2><p>Document fixes; either extend the pilot or approve controlled rollout.</p></div><div class=\"owner\">Finance Owner</div></div>\n        </div>\n        <p class=\"timeline-note\"><strong>Manager instruction:</strong> for pilot receipts, capture in Expensify and do not perform routine Webster Safari attachment unless finance requests a specific backup check.</p>\n      </section>\n      <aside class=\"criteria-panel\">\n        <div class=\"section-label\">Pilot acceptance gates</div>\n        <div class=\"criteria\">\n          <div class=\"criterion\"><div class=\"criterion-id\">01</div><h3>Feed delivery</h3><p>All posted pilot charges reach the assigned manager account.</p></div>\n          <div class=\"criterion\"><div class=\"criterion-id\">02</div><h3>Readable scan</h3><p>At least 90% of normal receipts scan cleanly on first capture.</p></div>\n          <div class=\"criterion\"><div class=\"criterion-id\">03</div><h3>Correct match</h3><p>At least 9 of 10 ordinary items auto-match or need only simple review.</p></div>\n          <div class=\"criterion\"><div class=\"criterion-id\">04</div><h3>Correct coding</h3><p>No incorrect automatic Property or GL result.</p></div>\n          <div class=\"criterion\"><div class=\"criterion-id\">05</div><h3>Mobile speed</h3><p>Normal capture takes under 15 seconds.</p></div>\n          <div class=\"criterion\"><div class=\"criterion-id\">06</div><h3>Portal use</h3><p>Zero routine Webster Safari uploads.</p></div>\n        </div>\n        <div class=\"decision\"><strong>Pass = expand</strong><span>One incorrect automatic Property rule requires correction and re-test before rollout.</span></div>\n      </aside>\n    </main>\n    <footer class=\"footer\"><span><strong>Success condition:</strong> the manager captures once; finance sees only meaningful exceptions.</span><span>08 / 12</span></footer>\n  </div>\n</body>\n</html>\n","height":720,"id":"pilot","note":"","path":"/home/ubuntu/expensify_webster_manager_deck/pilot.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #1A1A24; display: flex; flex-direction: column; }\n    .header { min-height: 116px; border-bottom: 2px solid #1A1A24; padding-top: 29px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; }\n    .eyebrow, .source, .footer, .week-label, .metric-label { font-family: \"Courier New\", monospace; font-size: 12px; letter-spacing: 0.85px; text-transform: uppercase; }\n    .eyebrow, .source { color: #4A4A68; }\n    .source { text-align: right; line-height: 1.45; }\n    h1 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 47px; line-height: 0.92; letter-spacing: -0.7px; text-transform: uppercase; margin-top: 10px; }\n    /* Reduced main min-height by 26px to remove 25px overflow */\n    .main { min-height: 508px; padding-top: 20px; padding-right: 56px; padding-left: 56px; }\n    .principle { min-height: 46px; border-left: 8px solid #DFFF00; padding-top: 3px; padding-left: 12px; font-family: \"Courier New\", monospace; font-size: 15px; line-height: 1.42; color: #4A4A68; }\n    .principle strong { color: #1A1A24; }\n    .weeks { min-height: 220px; margin-top: 12px; border-top: 2px solid #1A1A24; border-left: 2px solid #1A1A24; display: grid; grid-template-columns: repeat(4, 1fr); }\n    .week { border-right: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; padding-top: 12px; padding-right: 12px; padding-left: 12px; display: flex; flex-direction: column; justify-content: space-between; }\n    .week-label { color: #7B9300; }\n    .week h2 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 31px; line-height: 0.91; text-transform: uppercase; margin-top: 8px; }\n    .week p { font-family: \"Courier New\", monospace; font-size: 13px; line-height: 1.42; color: #4A4A68; margin-top: 8px; }\n    .guard { min-height: 36px; border-top: 2px solid #4A4A68; padding-top: 6px; font-family: \"Courier New\", monospace; font-size: 11px; line-height: 1.25; color: #1A1A24; }\n    .week-one { background: #1A1A24; color: #FFFFFF; }\n    .week-one p { color: #D8D8E2; }\n    .week-one .guard { border-top-color: #DFFF00; color: #DFFF00; }\n    .metrics { min-height: 100px; margin-top: 12px; border-top: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; display: grid; grid-template-columns: 1.05fr 1fr 1fr 1.3fr; }\n    .metric { border-right: 2px solid #1A1A24; padding-top: 10px; padding-right: 12px; padding-left: 12px; }\n    .metric:last-child { border-right: 0; }\n    .metric-label { color: #4A4A68; }\n    .metric-value { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 29px; line-height: 0.94; text-transform: uppercase; margin-top: 6px; }\n    .metric-copy { font-family: \"Courier New\", monospace; font-size: 11px; line-height: 1.3; color: #4A4A68; margin-top: 6px; }\n    .lime { color: #7B9300; }\n    .footer { min-height: 70px; border-top: 2px solid #1A1A24; padding-top: 19px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; color: #4A4A68; }\n    .footer strong { color: #1A1A24; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <header class=\"header\">\n      <div>\n        <div class=\"eyebrow\">08 / Controlled expansion</div>\n        <h1>30-day rule rollout: automate carefully</h1>\n      </div>\n      <div class=\"source\">Internal pilot targets<br>not vendor guarantees</div>\n    </header>\n    <main class=\"main\">\n      <div class=\"principle\"><strong>Expansion rule:</strong> add automation only after finance confirms the prior week’s receipts matched and coded correctly.</div>\n      <section class=\"weeks\">\n        <article class=\"week week-one\">\n          <div><div class=\"week-label\">Week 1</div><h2>Establish baseline</h2><p>Capture ten ordinary receipts. Confirm feed delivery, SmartScan readability, matching, and exceptions.</p></div>\n          <div class=\"guard\">GUARDRAIL: no auto-approval; no new Property rules.</div>\n        </article>\n        <article class=\"week\">\n          <div><div class=\"week-label\">Week 2</div><h2>Add exact merchant rules</h2><p>Add 5–10 finance-validated exact matches for repeating vendors. Use Preview before activation.</p></div>\n          <div class=\"guard\">GUARDRAIL: category-only for shared hotel and retailer brands.</div>\n        </article>\n        <article class=\"week\">\n          <div><div class=\"week-label\">Week 3</div><h2>Refine Property → GL</h2><p>Adjust dependent tags and allowed combinations based on pilot exceptions.</p></div>\n          <div class=\"guard\">GUARDRAIL: keep multi-property vendors visible for human selection.</div>\n        </article>\n        <article class=\"week\">\n          <div><div class=\"week-label\">Week 4</div><h2>Decide what scales</h2><p>Review exception rate, manager effort, and export quality. Expand only clean rules.</p></div>\n          <div class=\"guard\">GUARDRAIL: retain weekly finance review if exceptions persist.</div>\n        </article>\n      </section>\n      <section class=\"metrics\">\n        <div class=\"metric\"><div class=\"metric-label\">Manager capture / ordinary receipt</div><div class=\"metric-value\"><span class=\"lime\">&lt;15 sec</span></div><div class=\"metric-copy\">Target after workflow stabilizes</div></div>\n        <div class=\"metric\"><div class=\"metric-label\">Daily manager touch time / 30 receipts</div><div class=\"metric-value\"><span class=\"lime\">2.5–7.5 min</span></div><div class=\"metric-copy\">At ~5–15s per routine capture</div></div>\n        <div class=\"metric\"><div class=\"metric-label\">SmartScan readable capture</div><div class=\"metric-value\"><span class=\"lime\">≥95%</span></div><div class=\"metric-copy\">Month-one target</div></div>\n        <div class=\"metric\"><div class=\"metric-label\">Non-negotiable quality control</div><div class=\"metric-value\">0 incorrect<br>auto-Property codes</div><div class=\"metric-copy\">Visible exceptions OK; silent miscoding is not</div></div>\n      </section>\n    </main>\n    <footer class=\"footer\"><span><strong>Measure the outcome:</strong> less manager time, accurate coding, and zero routine Webster Safari uploads.</span><span>09 / 12</span></footer>\n  </div>\n</body>\n</html>\n","height":720,"id":"rollout","note":"","path":"/home/ubuntu/expensify_webster_manager_deck/rollout.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #1A1A24; display: flex; flex-direction: column; }\n    .header { min-height: 116px; border-bottom: 2px solid #1A1A24; padding-top: 29px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; }\n    .eyebrow, .meta, .footer, .field, .request-id { font-family: \"Courier New\", monospace; font-size: 12px; letter-spacing: 0.85px; text-transform: uppercase; }\n    .eyebrow, .meta { color: #4A4A68; }\n    .meta { line-height: 1.45; text-align: right; }\n    h1 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 46px; line-height: 0.92; letter-spacing: -0.7px; text-transform: uppercase; margin-top: 10px; }\n    /* reduced body min-height to fit content without overflow */\n    .body { min-height: 495px; display: grid; grid-template-columns: 33% 67%; }\n    /* Shrink top padding in the left column and tighten spacing between blocks */\n    .email-brief { border-right: 2px solid #1A1A24; padding-top: 12px; padding-right: 30px; padding-left: 56px; display: flex; flex-direction: column; justify-content: space-between; }\n    .field { color: #4A4A68; margin-bottom: 8px; }\n    .subject { border-top: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; padding-top: 8px; padding-right: 14px; padding-left: 14px; font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 26px; line-height: 0.95; text-transform: uppercase; }\n    /* reduce spacing above send blocks */\n    .send-block { margin-top: 8px; font-family: \"Courier New\", monospace; font-size: 13px; line-height: 1.48; color: #4A4A68; }\n    .send-block strong { color: #1A1A24; }\n    .why { background: #1A1A24; color: #FFFFFF; padding-top: 10px; padding-right: 17px; padding-left: 17px; padding-bottom: 10px; font-family: \"Courier New\", monospace; font-size: 13px; line-height: 1.42; }\n    .why strong { color: #DFFF00; font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 22px; line-height: 0.95; text-transform: uppercase; display: block; margin-bottom: 8px; }\n    /* Reduced top padding in requests column to save vertical space */\n    .requests { padding-top: 12px; padding-right: 56px; padding-left: 34px; }\n    .request-title { font-family: \"Courier New\", monospace; font-size: 13px; line-height: 1.35; color: #4A4A68; text-transform: uppercase; margin-bottom: 18px; }\n    .matrix { border-top: 2px solid #1A1A24; border-left: 2px solid #1A1A24; display: grid; grid-template-columns: repeat(3, 1fr); }\n    .request { min-height: 120px; border-right: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; padding-top: 10px; padding-right: 15px; padding-left: 15px; }\n    .request-id { color: #7B9300; }\n    .request h2 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 22px; line-height: 0.93; text-transform: uppercase; margin-top: 8px; }\n    .request p { font-family: \"Courier New\", monospace; font-size: 12px; line-height: 1.34; color: #4A4A68; margin-top: 8px; }\n    .request.wide { grid-column: span 3; min-height: 74px; background: #DFFF00; display: grid; grid-template-columns: 140px 1fr; column-gap: 15px; }\n    .request.wide h2 { margin-top: 0; align-self: center; }\n    .request.wide p { color: #1A1A24; margin-top: 0; align-self: center; }\n    .footer { min-height: 70px; border-top: 2px solid #1A1A24; padding-top: 19px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; color: #4A4A68; }\n    .footer strong { color: #1A1A24; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <header class=\"header\">\n      <div>\n        <div class=\"eyebrow\">09 / Bank outreach</div>\n        <h1>Ready-to-send request to Webster</h1>\n      </div>\n      <div class=\"meta\">Use the bank program administrator<br>or relationship manager channel</div>\n    </header>\n    <main class=\"body\">\n      <section class=\"email-brief\">\n        <div>\n          <div class=\"field\">Recommended subject line</div>\n          <div class=\"subject\">Enable Visa Commercial Format feed to Expensify</div>\n          <div class=\"send-block\"><strong>To:</strong> Webster program administrator / relationship manager<br><strong>CC:</strong> Finance owner • Expensify Workspace Admin • IT/Security, if required</div>\n          <div class=\"send-block\"><strong>Core request:</strong><br>Confirm eligibility for a Visa Commercial Format (VCF) feed to Expensify and, if eligible, enable feed delivery through the applicable Visa Subscription Management process.</div>\n        </div>\n        <div class=\"why\"><strong>Do not ask for a better upload screen.</strong>The requested outcome is a transaction feed that makes iPhone receipt matching possible.</div>\n      </section>\n      <section class=\"requests\">\n        <div class=\"request-title\">Ask Webster to provide or confirm each item through a secure channel</div>\n        <div class=\"matrix\">\n          <div class=\"request\"><div class=\"request-id\">01</div><h2>Processor ID</h2><p>Required to configure the Visa commercial feed in Expensify.</p></div>\n          <div class=\"request\"><div class=\"request-id\">02</div><h2>Bank / FI ID</h2><p>Financial Institution or Bank ID required by the Expensify VCF setup.</p></div>\n          <div class=\"request\"><div class=\"request-id\">03</div><h2>Company ID</h2><p>Company identifier for the Webster commercial-card program.</p></div>\n          <div class=\"request\"><div class=\"request-id\">04</div><h2>Feed timing</h2><p>Feed start date and expected delivery cadence for posted card transactions.</p></div>\n          <div class=\"request\"><div class=\"request-id\">05</div><h2>Transaction state</h2><p>Whether the feed sends posted transactions only or also supports pending/real-time alerts.</p></div>\n          <div class=\"request\"><div class=\"request-id\">06</div><h2>Implementation contact</h2><p>A Webster technical/program contact for coordination with Expensify if needed.</p></div>\n          <div class=\"request wide\"><h2>07 / Program-terms confirmation</h2><p>Confirm that enabling the feed does not alter cardholder privileges, liability arrangement, payment responsibility, or existing Webster card-program terms.</p></div>\n        </div>\n      </section>\n    </main>\n    <footer class=\"footer\"><span><strong>Important:</strong> transmit identifiers through an approved secure channel; do not include card numbers in ordinary email.</span><span>10 / 12</span></footer>\n  </div>\n</body>\n</html>\n","height":720,"id":"webster_request","note":"","path":"/home/ubuntu/expensify_webster_manager_deck/webster_request.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #1A1A24; display: flex; flex-direction: column; }\n    .header { min-height: 116px; border-bottom: 2px solid #1A1A24; padding-top: 29px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; }\n    .eyebrow, .source, .footer, .column-label, .task-id { font-family: \"Courier New\", monospace; font-size: 12px; letter-spacing: 0.85px; text-transform: uppercase; }\n    .eyebrow, .source { color: #4A4A68; }\n    .source { text-align: right; line-height: 1.44; }\n    h1 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 47px; line-height: 0.92; letter-spacing: -0.7px; text-transform: uppercase; margin-top: 10px; }\n    .main { min-height: 534px; padding-top: 31px; padding-right: 56px; padding-left: 56px; }\n    .intro { min-height: 52px; border-left: 8px solid #DFFF00; padding-top: 4px; padding-left: 15px; font-family: \"Courier New\", monospace; font-size: 15px; line-height: 1.4; color: #4A4A68; }\n    .intro strong { color: #1A1A24; }\n    .matrix { min-height: 290px; margin-top: 26px; border-top: 2px solid #1A1A24; border-left: 2px solid #1A1A24; display: grid; grid-template-columns: 1fr 1fr 1fr; }\n    .col { border-right: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; }\n    .col-head { min-height: 68px; background: #1A1A24; color: #FFFFFF; padding-top: 17px; padding-right: 17px; padding-left: 17px; }\n    .column-label { color: #DFFF00; }\n    .col-head h2 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 26px; line-height: 0.93; text-transform: uppercase; margin-top: 7px; }\n    .task { min-height: 110px; border-bottom: 2px solid #1A1A24; padding-top: 14px; padding-right: 17px; padding-left: 17px; }\n    .task:last-child { border-bottom: 0; }\n    .task-id { color: #7B9300; }\n    .task h3 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 22px; line-height: 0.94; text-transform: uppercase; margin-top: 8px; }\n    .task p { font-family: \"Courier New\", monospace; font-size: 12px; line-height: 1.34; color: #4A4A68; margin-top: 8px; }\n    .activation { min-height: 78px; margin-top: 23px; border: 2px solid #1A1A24; display: grid; grid-template-columns: 176px 1fr; }\n    .activation-head { background: #DFFF00; padding-top: 19px; padding-right: 14px; padding-left: 14px; font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 24px; line-height: 0.94; text-transform: uppercase; }\n    .activation-flow { display: grid; grid-template-columns: repeat(4, 1fr); }\n    .flow-step { border-right: 2px solid #1A1A24; padding-top: 13px; padding-right: 14px; padding-left: 14px; }\n    .flow-step:last-child { border-right: 0; }\n    .flow-id { font-family: \"Courier New\", monospace; font-size: 11px; color: #7B9300; }\n    .flow-step p { font-family: \"Courier New\", monospace; font-size: 11px; line-height: 1.28; color: #4A4A68; margin-top: 7px; }\n    .footer { min-height: 70px; border-top: 2px solid #1A1A24; padding-top: 19px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; color: #4A4A68; }\n    .footer strong { color: #1A1A24; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <header class=\"header\">\n      <div>\n        <div class=\"eyebrow\">10 / Launch accountability</div>\n        <h1>Next steps and owners</h1>\n      </div>\n      <div class=\"source\">No routine cutover until the feed,<br>coding map, and pilot acceptance gates are complete</div>\n    </header>\n    <main class=\"main\">\n      <div class=\"intro\"><strong>Sequencing matters:</strong> Webster enables the feed first; Expensify is configured second; the manager begins mobile capture only when her card, tags, and receipt rules have been tested.</div>\n      <section class=\"matrix\">\n        <article class=\"col\">\n          <div class=\"col-head\"><div class=\"column-label\">External program owner</div><h2>Webster program administrator</h2></div>\n          <div class=\"task\"><div class=\"task-id\">01</div><h3>Send VCF request</h3><p>Submit the formal request for Visa Commercial Format delivery to Expensify and retain the case/contact details.</p></div>\n          <div class=\"task\"><div class=\"task-id\">02</div><h3>Provide identifiers</h3><p>Securely provide the Processor ID, Bank ID, Company ID, start date, cadence, and implementation contact.</p></div>\n        </article>\n        <article class=\"col\">\n          <div class=\"col-head\"><div class=\"column-label\">Internal policy owner</div><h2>Finance owner</h2></div>\n          <div class=\"task\"><div class=\"task-id\">03</div><h3>Approve coding map</h3><p>Validate Property, permitted GL combinations, categories, receipt threshold, and exception workflow.</p></div>\n          <div class=\"task\"><div class=\"task-id\">04</div><h3>Sign off pilot</h3><p>Review ten receipts for match, coding, approval, and export readiness before scaling.</p></div>\n        </article>\n        <article class=\"col\">\n          <div class=\"col-head\"><div class=\"column-label\">System + user owners</div><h2>Expensify admin + regional manager</h2></div>\n          <div class=\"task\"><div class=\"task-id\">05</div><h3>Configure + assign</h3><p>Create the pilot Workspace, connect the VCF feed, assign the manager card, and test tags/rules.</p></div>\n          <div class=\"task\"><div class=\"task-id\">06</div><h3>Capture + report</h3><p>Manager captures ten live receipts in Expensify; reports only scan, match, or coding exceptions.</p></div>\n        </article>\n      </section>\n      <section class=\"activation\">\n        <div class=\"activation-head\">Launch sequence</div>\n        <div class=\"activation-flow\">\n          <div class=\"flow-step\"><div class=\"flow-id\">STEP 1</div><p>Webster confirms VCF eligibility and contact path.</p></div>\n          <div class=\"flow-step\"><div class=\"flow-id\">STEP 2</div><p>Workspace, Company Cards, Tags, Categories, and Rules are configured.</p></div>\n          <div class=\"flow-step\"><div class=\"flow-id\">STEP 3</div><p>Feed connects; the correct Webster card is assigned with a controlled start date.</p></div>\n          <div class=\"flow-step\"><div class=\"flow-id\">STEP 4</div><p>Ten-receipt pilot passes; finance authorizes controlled expansion.</p></div>\n        </div>\n      </section>\n    </main>\n    <footer class=\"footer\"><span><strong>Goal:</strong> make routine Webster Safari uploads unnecessary—not merely faster.</span><span>11 / 12</span></footer>\n  </div>\n</body>\n</html>\n","height":720,"id":"next_steps","note":"","path":"/home/ubuntu/expensify_webster_manager_deck/next_steps.html","width":1280},{"changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    .slide-container { width: 1280px; min-height: 720px; background: #FFFFFF; color: #1A1A24; display: flex; flex-direction: column; }\n    .header { min-height: 118px; border-bottom: 2px solid #1A1A24; padding-top: 29px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; }\n    .eyebrow, .source, .footer, .col-label, .setting-id { font-family: \"Courier New\", monospace; font-size: 12px; letter-spacing: 0.85px; text-transform: uppercase; }\n    .eyebrow, .source, .col-label { color: #4A4A68; }\n    .source { text-align: right; line-height: 1.45; }\n    h1 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 45px; line-height: 0.92; letter-spacing: -0.7px; text-transform: uppercase; margin-top: 10px; }\n    /* Reduced top padding to shave a few pixels without changing title spacing */\n    .main { min-height: 532px; padding-top: 26px; padding-right: 56px; padding-left: 56px; }\n    .intro { min-height: 44px; border-left: 8px solid #DFFF00; padding-top: 5px; padding-left: 15px; font-family: \"Courier New\", monospace; font-size: 14px; line-height: 1.42; color: #4A4A68; }\n    .intro strong { color: #1A1A24; }\n    /* Reduced spacing above the matrix to compact layout slightly */\n    .matrix { min-height: 297px; margin-top: 6px; border-top: 2px solid #1A1A24; border-left: 2px solid #1A1A24; display: grid; grid-template-columns: 1fr 1fr; }\n    .setting { border-right: 2px solid #1A1A24; border-bottom: 2px solid #1A1A24; display: grid; grid-template-columns: 90px 1fr 1.15fr; }\n    .setting-id { color: #7B9300; padding-top: 8px; padding-left: 14px; }\n    .setting-name { border-left: 2px solid #1A1A24; padding-top: 8px; padding-right: 13px; padding-left: 13px; }\n    .setting-name h2 { font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 22px; line-height: 0.94; text-transform: uppercase; }\n    .setting-name p { font-family: \"Courier New\", monospace; font-size: 11px; line-height: 1.3; color: #4A4A68; margin-top: 7px; }\n    .setting-value { border-left: 2px solid #1A1A24; padding-top: 8px; padding-right: 13px; padding-left: 13px; }\n    .setting-value strong { display: block; font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 19px; line-height: 0.95; text-transform: uppercase; color: #1A1A24; }\n    .setting-value span { display: block; font-family: \"Courier New\", monospace; font-size: 11px; line-height: 1.32; color: #4A4A68; margin-top: 7px; }\n    /* Slightly reduced dark-row min-height to regain a few pixels */\n    .dark-row { min-height: 72px; margin-top: 6px; background: #1A1A24; color: #FFFFFF; display: grid; grid-template-columns: 28% 72%; }\n    .dark-label { padding-top: 18px; padding-right: 20px; padding-left: 20px; font-family: Impact, \"Arial Narrow\", sans-serif; font-size: 25px; line-height: 0.94; color: #DFFF00; text-transform: uppercase; }\n    .dark-copy { border-left: 2px solid #4A4A68; padding-top: 14px; padding-right: 22px; padding-left: 22px; font-family: \"Courier New\", monospace; font-size: 13px; line-height: 1.4; color: #D8D8E2; }\n    .footer { min-height: 70px; border-top: 2px solid #1A1A24; padding-top: 19px; padding-right: 56px; padding-left: 56px; display: flex; justify-content: space-between; color: #4A4A68; }\n    .footer strong { color: #1A1A24; }\n  </style>\n</head>\n<body>\n  <div class=\"slide-container\">\n    <header class=\"header\">\n      <div>\n        <div class=\"eyebrow\">Appendix / Administrator checklist</div>\n        <h1>Initial settings for a safe pilot</h1>\n      </div>\n      <div class=\"source\">Configuration guidance based on<br>current Expensify Help documentation</div>\n    </header>\n    <main class=\"main\">\n      <div class=\"intro\"><strong>Set the controls before the first live receipt.</strong> These are pilot defaults; finance policy and the approved accounting map take priority over any generic setting.</div>\n      <section class=\"matrix\">\n        <article class=\"setting\"><div class=\"setting-id\">01</div><div class=\"setting-name\"><h2>Receipt required</h2><p>Keep missing proof visible.</p></div><div class=\"setting-value\"><strong>Finance policy threshold</strong><span>Use $0.01 only if every Webster charge requires a receipt image.</span></div></article>\n        <article class=\"setting\"><div class=\"setting-id\">02</div><div class=\"setting-name\"><h2>Itemized receipt</h2><p>Protect high-detail spend.</p></div><div class=\"setting-value\"><strong>Lodging + policy-sensitive categories</strong><span>Require complete hotel folios and any category finance identifies.</span></div></article>\n        <article class=\"setting\"><div class=\"setting-id\">03</div><div class=\"setting-name\"><h2>Property tag</h2><p>Primary allocation field.</p></div><div class=\"setting-value\"><strong>Enabled + required attention indicator</strong><span>Manager selects only when a tested rule cannot safely fill it.</span></div></article>\n        <article class=\"setting\"><div class=\"setting-id\">04</div><div class=\"setting-name\"><h2>GL tag / Category</h2><p>Accounting-ready coding.</p></div><div class=\"setting-value\"><strong>Dependent on Property where needed</strong><span>Show only finance-approved GL choices after Property selection.</span></div></article>\n        <article class=\"setting\"><div class=\"setting-id\">05</div><div class=\"setting-name\"><h2>Merchant rules</h2><p>Known-pattern automation.</p></div><div class=\"setting-value\"><strong>5–10 exact matches only</strong><span>Preview matches; no broad rule for shared vendors or new merchants.</span></div></article>\n        <article class=\"setting\"><div class=\"setting-id\">06</div><div class=\"setting-name\"><h2>eReceipts</h2><p>Optional low-dollar support.</p></div><div class=\"setting-value\"><strong>Optional qualifying USD items ≤$75</strong><span>Do not rely on it for lodging or to replace policy-required source receipts.</span></div></article>\n        <article class=\"setting\"><div class=\"setting-id\">07</div><div class=\"setting-name\"><h2>Auto-approval</h2><p>Approval and policy control.</p></div><div class=\"setting-value\"><strong>Off during the pilot</strong><span>Consider later only after stable matching, coding, and exception evidence.</span></div></article>\n        <article class=\"setting\"><div class=\"setting-id\">08</div><div class=\"setting-name\"><h2>Finance review</h2><p>Feedback loop for rules.</p></div><div class=\"setting-value\"><strong>Daily Week 1; weekly through Month 1</strong><span>Adjust a rule only from verified receipt and transaction evidence.</span></div></article>\n      </section>\n      <section class=\"dark-row\"><div class=\"dark-label\">Final guardrail</div><div class=\"dark-copy\">The goal is not maximum automation on day one. The goal is a reliable iPhone process in which routine receipts take seconds and every uncertain match, Property, or GL code remains visible to finance.</div></section>\n    </main>\n    <footer class=\"footer\"><span><strong>End state:</strong> capture on iPhone; match and code in Expensify; review only exceptions.</span><span>12 / 12</span></footer>\n  </div>\n</body>\n</html>\n","height":720,"id":"appendix_settings","note":"","path":"/home/ubuntu/expensify_webster_manager_deck/appendix_settings.html","width":1280}],"images":{"appendix_settings":"https://private-us-east-1.manuscdn.com/slides_screenshots/310519663449376037/SMCOeiykXcc8TPY00lOauJ/23b4eed1-d8a0-48a5-b14f-0709c07cf613/903815c6-d4b8-45a9-bae9-651617137472_11.png?Expires=1787336702&Signature=g-emyPibVH6PV0XBRtTHV9ve~mHRj27YnOjLUUFWMUtz9RJcNYnwEDDm4Qh5GjE8WXANOq59j-iR~eK07yULH1x2j5XfpkkvRTDr5Ym0DiNXZBxYOhbVbYGAlXNz-Bvu0dlqZMoCJp9ofAP3mTSoguMGfRUptIJxvSaRsNHTpijbwNfsv2SV5P7luhxySNOkw~GRuck~ZpD-A0P-EITkX7suIFyEMK~Lz5LtMoS4UxHHxgTPjQ~XjWxaYAs4YYE5oYpymhxbOBG319fMBhn~Rkh79OZYT3xFdqYmPbdzm3suzldYbxUC